<!doctype html>

<html lang="{{ request.locale.iso_code }}" dir="{% render 'direction' %}">
  <head>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, height=device-height, minimum-scale=1.0, maximum-scale=5.0"
    >

    <title>
      {% if page_title == blank -%}
        {{- shop.name -}}
      {%- else -%}
        {{- page_title -}}
        {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- endif %}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon -%}
      <link rel="shortcut icon" href="{{ settings.favicon | image_url: width: 96 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180 }}">
    {%- endif -%}

    {%- comment -%}Few prefetch to increase performance on commonly used third-parties{%- endcomment -%}
    <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

    {%- unless settings.heading_font.system? -%}
      <link rel="preload" href="{{ settings.heading_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- unless settings.text_font.system? -%}
      <link rel="preload" href="{{ settings.text_font | font_url }}" as="font" type="font/woff2" crossorigin>
    {%- endunless -%}

    {%- render 'social-meta-tags' -%}
    {%- render 'microdata-schema' -%}
    {%- render 'css-variables' -%}
    {%- render 'js-variables' -%}

    {%- if request.page_type == 'gift_card' -%}
      <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {%- endif -%}

    <script type="importmap">
      {%- comment -%}On Safari 16.3 and lower, a polyfill is used to load importmap{%- endcomment -%}
      {
        "imports": {
          "vendor": "{{ 'vendor.min.js' | asset_url }}",
          "theme": "{{ 'theme.js' | asset_url }}",
          "photoswipe": "{{ 'photoswipe.min.js' | asset_url }}"
        }
      }
    </script>

    <script type="module" src="{{ 'vendor.min.js' | asset_url }}"></script>
    <script type="module" src="{{ 'theme.js' | asset_url }}"></script>

    {{ content_for_header }}

    {{- 'theme.css' | asset_url | stylesheet_tag: preload: true -}}
    <style>
            /* ============================================================
               C&B HEADER — layout & spacing only, no colour/theme changes
               ============================================================ */

            #shopify-section-sections--23238268223731__header x-header {
              --header-padding-block: 0.75rem !important;
              border-bottom: 1px solid rgba(0,0,0,0.1);
            }

            /* ---------------- DESKTOP (top of page) ---------------- */
            @media screen and (min-width: 1000px) {

              #shopify-section-sections--23238268223731__header x-header {
                --header-grid:
                  "primary-nav logo secondary-nav"
                  / minmax(0,1fr) auto minmax(0,1fr) !important;
                align-items: center;
              }

              /* nav spans the full row so it can centre around the logo */
              #shopify-section-sections--23238268223731__header .header__primary-nav {
                grid-column: 1 / -1;
                grid-row: 1;
                align-self: center;                 /* sit on the wordmark's line */
                padding-block-end: 0;
                pointer-events: none;
              }

              /* the list is the real flex container (the bar's own list only: `>` keeps
                 this off the link lists inside the category mega menu panels) */
              #shopify-section-sections--23238268223731__header .header__primary-nav > :is(ul, menu) {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 3.5rem;
                margin: 0;
                padding: 0;
                list-style: none;
                width: 100%;
              }

              #shopify-section-sections--23238268223731__header .header__primary-nav a,
              #shopify-section-sections--23238268223731__header .header__primary-nav summary {
                pointer-events: auto;
              }

              /* THE HOLE — opens after the 2nd link, sized to the wordmark */
              #shopify-section-sections--23238268223731__header .header__primary-nav > :is(ul, menu) > li:nth-child(2) {
                margin-inline-end: clamp(19rem, 20vw, 24rem);
              }

              #shopify-section-sections--23238268223731__header .header__logo {
                grid-area: logo;
                grid-row: 1;
                position: relative;
                z-index: 2;
                justify-self: center;
                align-self: center;                 /* share the nav's line */
                margin-block: 0;
                pointer-events: auto;
              }

              /* the wordmark and the links sit on one optical line */
              #shopify-section-sections--23238268223731__header .header__logo :is(img, .header__logo-text) {
                display: block;
              }
            }

            /* ---------------- TYPOGRAPHY SPACING ---------------- */
            #shopify-section-sections--23238268223731__header .header__primary-nav a,
            #shopify-section-sections--23238268223731__header .header__primary-nav summary {
              letter-spacing: 0.18em;
              font-size: 0.7rem;
              white-space: nowrap;
            }

            /* ---------------- SCROLLED STATE ---------------- */
      .header-logo-hidden .header__logo { display: none !important; }
      .header-logo-hidden x-header { --header-padding-block: 0.75rem !important; }

      @media screen and (min-width: 1000px) {

        .header-logo-hidden x-header {
          --header-grid:
            "logo primary-nav secondary-nav"
            / auto minmax(0,1fr) auto !important;
          align-items: center !important;
        }

        /* menu centred in the middle column, single line */
        .header-logo-hidden .header__primary-nav {
          grid-area: primary-nav !important;
          grid-column: primary-nav !important;
          grid-row: 1 !important;
          align-self: center !important;
          padding-block-end: 0 !important;
          padding-block-start: 0 !important;
          pointer-events: auto;
        }
        .header-logo-hidden .header__primary-nav :is(ul, menu) {
          display: flex;
          justify-content: center;
          align-items: center;
          gap: 2rem;                       /* tighter than the hero state */
          max-width: none !important;
          width: 100%;
          margin: 0 !important;
          flex-wrap: nowrap;
        }

        /* CRITICAL: kill the logo hole — no gap in the compact bar */
        .header-logo-hidden .header__primary-nav :is(ul, menu) > li:nth-child(2) {
          margin-inline-end: 0 !important;
        }
        .header-logo-hidden .header__primary-nav :is(ul, menu) > li:nth-child(3) {
          margin-inline-start: 0 !important;
        }

        /* small mark, hard left */
        .header-logo-hidden .header-scroll-logo {
          grid-area: logo !important;
          grid-row: 1 !important;
          align-self: center !important;
          justify-self: start !important;
          padding-right: 0 !important;
        }

        /* icons, hard right, same line */
        .header-logo-hidden .header__secondary-nav {
          grid-area: secondary-nav !important;
          grid-row: 1 !important;
          align-self: center !important;
          justify-self: end !important;
          padding-block-start: 0 !important;
          padding-block-end: 0 !important;
          gap: 1.5rem;
        }
      }

    </style>

    <style>
      /*
        Gold hover for breadcrumbs and product titles: the header's gold (--header-gold,
        #ad7d31, in sections/header.liquid), spelled out because that variable is scoped
        to the header section.
      */
      @media screen and (pointer: fine) {
        .breadcrumb a:hover,
        a.product-title:hover,
        .product-card:has(.product-card__media:hover) .product-title {
          color: rgb(173 125 49);
        }
      }

      .product-card .product-title {
        transition: color .2s ease-in-out;
      }

      /*
        Phones: product names on cards stop at two lines with "…", so every card is image,
        two lines of name, then the price. Long names ("1.17 CTW Round Brilliant Lab-Grown
        Diamond Halo Pendant Necklace") ran to four. Desktop shows the whole name.
      */
      @media screen and (max-width: 699px) {
        .product-card .product-title {
          display: -webkit-box;
          -webkit-box-orient: vertical;
          -webkit-line-clamp: 2;
          overflow: hidden;
        }
      }

      /*
        Buttons are gold with white text everywhere ("View all", "View products", Add to cart,
        Subscribe...), instead of each colour scheme's own button colour. On hover the theme's
        wipe turns them transparent with gold text and border. A button given its own colours
        (the block's Background / Text settings, printed inline) keeps them, and so do the
        buttons inside error / success / warning messages, which follow the message's colours.
      */
      :is(.button, .shopify-challenge__button):not(.banner *) {
        --button-background: 173 125 49;
        --button-text-color: 255 255 255;
        --button-outline-color: 173 125 49;
      }

      /* Collection title ("NECKLACES", "TENNIS BRACELETS"...) in the header's gold, on every collection page. */
      .shopify-section--collection-banner h1 {
        color: rgb(173 125 49);
      }

      /* Collection subheading (the description under the title): smaller and tracked out. */
      .shopify-section--collection-banner .collection-description {
        font-size: 0.6875rem;
        letter-spacing: 0.08em;
        line-height: 1.8;
      }
    </style>
  </head>

  {% liquid
    assign features_class = ''

    if settings.show_button_transition
      assign features_class = features_class | append: 'features--button-transition '
    endif

    if settings.show_image_zoom_on_hover
      assign features_class = features_class | append: 'features--zoom-image '
    endif
  %}

  <body class="{{ features_class }} color-scheme color-scheme--{{ settings.default_color_scheme.id }}{% if request.page_type == 'policy' and request.path contains 'shipping-policy' %} policy-shipping{% endif %}">
    {%- render 'shadow-dom-templates' -%}

    <loading-bar class="loading-bar" aria-hidden="true"></loading-bar>
    <a href="#main" allow-hash-change class="skip-to-content sr-only">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    {%- comment -%}
      This placeholder will be filled to screen readers for any kind of announcements
    {%- endcomment -%}
    <div class="sr-only" role="status" aria-live="polite" aria-atomic="true">
      <span id="status-announcement"></span>
    </div>

    <div class="sr-only" role="alert" aria-live="assertive" aria-atomic="true">
      <span id="error-announcement"></span>
    </div>

    <span
      id="header-scroll-tracker"
      style="position: absolute; width: 1px; height: 1px; top: var(--header-scroll-tracker-offset, 10px); left: 0;"
    >
      {%- comment -%}
        This allows our theme to track when the user has scrolled a given amount of pixels, without relying on a global scroll listener. This helps
        to improve performance and reduce reflows.
      {%- endcomment -%}
    </span>

    {%- if request.page_type != 'password' -%}
      {%- sections 'header-group' -%}
      {%- sections 'overlay-group' -%}
    {%- endif -%}

    <main id="main" class="anchor">
      {{ content_for_layout }}

      {%- comment -%}
        IMPLEMENTATION NOTE: For best semantics, having the footer group outside the main would be slightly better, but
          moving it inside the main allows to have all the sections (including sections inside the footer group) to be
          consecutive, and hence having a cleaner margin collapsing management.
      {%- endcomment -%}
      {%- if request.page_type != 'password' -%}
        {%- sections 'footer-group' -%}
      {%- endif -%}
    </main>

    {%- if request.page_type == 'policy' and request.path contains 'privacy-policy' -%}
      <script>
        (() => {
          const oldEmail = 'sanjayp@chainandbracelet.com';
          const newEmail = 'info@chainandbracelet.com';
          const policyBody = document.querySelector('.shopify-policy__body');

          if (!policyBody) return;

          policyBody.querySelectorAll(`a[href="mailto:${oldEmail}"]`).forEach((link) => {
            link.href = `mailto:${newEmail}`;
            link.textContent = newEmail;
          });

          const walker = document.createTreeWalker(policyBody, NodeFilter.SHOW_TEXT);
          const textNodes = [];

          while (walker.nextNode()) {
            if (walker.currentNode.nodeValue.includes(oldEmail) && walker.currentNode.parentElement?.tagName !== 'A') {
              textNodes.push(walker.currentNode);
            }
          }

          textNodes.forEach((textNode) => {
            const parts = textNode.nodeValue.split(oldEmail);
            const fragment = document.createDocumentFragment();

            parts.forEach((part, index) => {
              fragment.append(part);

              if (index < parts.length - 1) {
                const link = document.createElement('a');
                link.href = `mailto:${newEmail}`;
                link.textContent = newEmail;
                fragment.append(link);
              }
            });

            textNode.replaceWith(fragment);
          });
        })();
      </script>
    {%- endif -%}
  
  </body>
</html>
