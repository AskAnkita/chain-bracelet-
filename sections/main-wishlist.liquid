{%- comment -%}
  Renders the customer's wishlist. Since favorites are stored client-side (see the
  window.Wishlist helper + <wishlist-button> defined in sections/header.liquid), this
  page can't loop over products server-side -- it reads the saved handles from
  localStorage on load, fetches each product's data with Shopify's /products/{handle}.js
  endpoint, and builds simple cards reusing the theme's existing product-card classes.
{%- endcomment -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="section-spacing container container--{{ section.settings.content_width }}">
    {%- if section.settings.heading != blank -%}
      <div class="v-stack gap-4 text-center" style="margin-block-end: var(--section-stack-gap, 2rem);">
        <h1 class="h1">{{ section.settings.heading }}</h1>
      </div>
    {%- endif -%}

    <div id="wishlist-loading-{{ section.id }}" class="text-center">
      <p class="text-subdued">{{ 'general.wishlist.loading' | t }}</p>
    </div>

    <div id="wishlist-empty-{{ section.id }}" class="v-stack gap-4 text-center" hidden>
      <p class="text-subdued">{{ 'general.wishlist.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="button button--outline justify-self-center">
        {{- 'general.wishlist.continue_shopping' | t -}}
      </a>
    </div>

    <div id="wishlist-grid-{{ section.id }}" class="product-list" hidden></div>
  </div>
</div>

{%- comment -%}
  Hidden templates, rendered once server-side so the JS below never hand-builds markup
  that duplicates snippet logic -- it just clones these and fills in the blanks.
{%- endcomment -%}
<template id="wishlist-card-template-{{ section.id }}">
  <product-card class="product-card">
    <div class="product-card__figure">
      {%- render 'wishlist-button', product: blank, class: 'product-card__wishlist-button' -%}
      <a href="#" class="product-card__media" draggable="false">
        <img class="product-card__image product-card__image--primary" loading="lazy" style="aspect-ratio: 1; object-fit: contain;" alt="">
      </a>
    </div>
    <div class="product-card__info">
      <div class="v-stack justify-items-center gap-1">
        <a href="#" class="product-title"></a>
        <price-list class="price-list">
          <sale-price class="text-subdued"></sale-price>
        </price-list>
      </div>
    </div>
  </product-card>
</template>

<style>
  #shopify-section-{{ section.id }} .product-list {
    --product-list-items-per-row: 2;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .product-list {
      --product-list-items-per-row: 3;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} .product-list {
      --product-list-items-per-row: 4;
    }
  }
</style>

<script>
  (() => {
    const loadingEl = document.getElementById('wishlist-loading-{{ section.id }}');
    const emptyEl = document.getElementById('wishlist-empty-{{ section.id }}');
    const gridEl = document.getElementById('wishlist-grid-{{ section.id }}');
    const cardTemplate = document.getElementById('wishlist-card-template-{{ section.id }}');
    const moneyFormat = window.themeVariables.settings.moneyFormat;

    function formatMoney(cents) {
      const value = (cents / 100).toFixed(2);
      const [whole, decimals] = value.split('.');
      const withCommas = whole.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
      return moneyFormat.replace(/\{\{\s*amount\s*\}\}/, `${withCommas}.${decimals}`);
    }

    function buildCard(product) {
      const card = cardTemplate.content.firstElementChild.cloneNode(true);
      const image = product.featured_image;

      card.setAttribute('handle', product.handle);
      card.querySelectorAll('a[href="#"]').forEach((link) => (link.href = product.url));
      card.querySelector('.product-title').textContent = product.title;
      card.querySelector('.price-list .text-subdued').textContent = formatMoney(product.price);

      const imageEl = card.querySelector('.product-card__image');
      if (image) {
        imageEl.src = image;
        imageEl.alt = product.featured_image_alt || product.title;
      } else {
        imageEl.remove();
      }

      const wishlistButton = card.querySelector('wishlist-button');
      wishlistButton.setAttribute('product-handle', product.handle);

      // If unfavorited from this page, drop the card right away instead of waiting for a refresh.
      wishlistButton.addEventListener('click', () => {
        setTimeout(() => {
          if (!window.Wishlist.has(product.handle)) {
            card.remove();
            if (!gridEl.children.length) {
              gridEl.hidden = true;
              emptyEl.hidden = false;
            }
          }
        }, 0);
      });

      return card;
    }

    async function init() {
      const handles = window.Wishlist ? window.Wishlist.get() : [];

      if (!handles.length) {
        loadingEl.hidden = true;
        emptyEl.hidden = false;
        return;
      }

      const results = await Promise.all(
        handles.map((handle) =>
          fetch(`${window.Shopify.routes.root}products/${handle}.js`)
            .then((response) => (response.ok ? response.json() : null))
            .catch(() => null)
        )
      );

      loadingEl.hidden = true;

      const products = results.filter(Boolean);

      // Silently drop handles that 404'd (deleted/unpublished product) from storage.
      if (products.length !== handles.length) {
        const validHandles = products.map((product) => product.handle);
        localStorage.setItem('wishlist', JSON.stringify(validHandles));
        document.dispatchEvent(new CustomEvent('wishlist:updated'));
      }

      if (!products.length) {
        emptyEl.hidden = false;
        return;
      }

      products.forEach((product) => gridEl.appendChild(buildCard(product)));
      gridEl.hidden = false;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_wishlist.name",
  "class": "shopify-section--main-wishlist",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Wishlist"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "xl", "label": "t:global.sizes.x_large" }
      ],
      "default": "lg"
    }
  ]
}
{% endschema %}
