{%- comment -%}The wishlist itself lives in snippets/wishlist.liquid.{%- endcomment -%}
{%- render 'wishlist',
  id: section.id,
  heading: section.settings.heading,
  color_scheme: section.settings.color_scheme.id,
  content_width: section.settings.content_width
-%}

{% schema %}
{
  "name": "t:sections.main_wishlist.name",
  "class": "shopify-section--main-wishlist",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Wishlist"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" },
        { "value": "xl", "label": "t:global.sizes.x_large" }
      ],
      "default": "lg"
    }
  ]
}
{% endschema %}
