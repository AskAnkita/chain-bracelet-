{%- comment -%}
  Shows a random handful of products (4 by default) from the store's other jewelry
  categories (Necklaces, Bracelets, Rings, Earrings), based on which category the
  current product belongs to -- e.g. on a ring: a necklace, a bracelet, earrings and
  one more from any of those three. Fully dynamic: nothing here is picked by hand,
  so it works unchanged across every product without per-product setup.

  Shopify caches the rendered page, so the randomness can't happen in Liquid.
  Instead each other category renders a pool of its first few products and a small
  script picks the cards to keep on every page view, before the cards are revealed.

  Category is detected from collection membership, matching the same four
  collection handles (necklaces, bracelets, rings, earrings) the main nav uses --
  see the left_nav_items/right_nav_items in sections/header.liquid. A product not
  in any of the four collections has no "other" categories to infer, so the
  section renders nothing rather than guessing.
{%- endcomment -%}

{%- liquid
  assign categories = 'necklaces,bracelets,rings,earrings' | split: ','
  assign current_category = blank

  for handle in categories
    for product_collection in product.collections
      if product_collection.handle == handle
        assign current_category = handle
        break
      endif
    endfor

    unless current_category == blank
      break
    endunless
  endfor
-%}

{%- if current_category != blank -%}
  <style>
    #shopify-section-{{ section.id }} {
      --product-list-items-per-row: 2;
      --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
      --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --product-list-items-per-row: {{ section.settings.products_per_row_desktop }};
      }
    }
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
    <div class="container">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.heading,
          heading_style: section.settings.heading_style,
          content: section.settings.content
        -%}

        {%- comment -%}
          Must be the <product-list> element, not a plain div: the cards are rendered
          with reveal-on-scroll, which theme.css starts at opacity 0, and only
          <product-list> fades them in. As a div the section showed its heading over
          three invisible cards.
        {%- endcomment -%}
        {%- liquid
          assign pool_per_category = 4
          assign pool_sizes = ''
        -%}
        <product-list class="product-list justify-center" data-cross-sell-show="{{ section.settings.products_to_show }}">
          {%- assign card_position = 0 -%}

          {%- for handle in categories -%}
            {%- if handle == current_category -%}
              {%- continue -%}
            {%- endif -%}

            {%- assign other_collection = collections[handle] -%}
            {%- assign pool_count = 0 -%}

            {%- if other_collection != blank -%}
              {%- for other_product in other_collection.products limit: 12 -%}
                {%- if other_product.id == product.id -%}
                  {%- continue -%}
                {%- endif -%}

                {%- assign card_position = card_position | plus: 1 -%}
                {%- assign pool_count = pool_count | plus: 1 -%}
                {%- render 'product-card',
                  product: other_product,
                  position: card_position,
                  reveal: settings.stagger_products_apparition,
                  section: section
                -%}

                {%- if pool_count >= pool_per_category -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- assign pool_sizes = pool_sizes | append: pool_count | append: ',' -%}
          {%- endfor -%}
        </product-list>

        {%- comment -%}
          Runs as soon as the list above is parsed, before theme.js upgrades
          <product-list> and reveals its cards. Takes one random card from each
          category in turn (random category order) until it has enough, so every
          category shows up before any repeats, then shuffles the picks and drops the
          rest.
        {%- endcomment -%}
        <script>
          (() => {
            const list = document.currentScript.previousElementSibling;
            if (!list || list.tagName !== 'PRODUCT-LIST') return;

            const show = parseInt(list.dataset.crossSellShow, 10) || 4;
            const sizes = '{{ pool_sizes }}'.split(',').filter(Boolean).map(Number);
            const cards = Array.from(list.querySelectorAll(':scope > product-card'));
            const shuffle = (items) => {
              for (let i = items.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [items[i], items[j]] = [items[j], items[i]];
              }
              return items;
            };

            let start = 0;
            const groups = sizes.map((size) => shuffle(cards.slice(start, start += size)));
            const picked = [];

            while (picked.length < show && groups.some((group) => group.length > 0)) {
              for (const group of shuffle([...groups])) {
                if (picked.length >= show) break;
                if (group.length > 0) picked.push(group.shift());
              }
            }

            cards.forEach((card) => { if (!picked.includes(card)) card.remove(); });
            shuffle(picked).forEach((card) => list.append(card));
          })();
        </script>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Category cross-sell",
  "enabled_on": {
    "templates": ["product"]
  },
  "class": "shopify-section--category-cross-sell",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a random pick of products from the other three jewelry categories (Necklaces, Bracelets, Rings, Earrings) -- at least one from each -- chosen again on every page view. Nothing to pick by hand -- add this once and it adapts per product."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 8,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 4,
      "label": "t:global.product_list.products_per_row_desktop",
      "default": 4
    },
    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",
      "info": "t:global.product_list.spacing_category_info"
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "horizontal_spacing_factor",
      "label": "t:global.product_list.horizontal_spacing_factor",
      "default": 1
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "vertical_spacing_factor",
      "label": "t:global.product_list.vertical_spacing_factor",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading",
      "default": "Extend the harmony with"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.style",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    }
  ],
  "presets": [
    {
      "name": "Category cross-sell",
      "category": "t:global.categories.products"
    }
  ]
}
{% endschema %}
