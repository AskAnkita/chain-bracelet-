{%- comment -%}
  One row per merchant-picked collection: a tall image tile (title overlaid, links to the
  collection) followed by that collection's own top N products, all in one row. Meant for
  the "/collections" all-collections page, to preview what's inside each category instead
  of only linking out to it -- main-list-collections.liquid's own grid is tile-only, with
  no product preview.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <style>
    #shopify-section-{{ section.id }} .category-products-showcase__row {
      display: grid;
      gap: 1rem;
      min-width: 0;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__row + .category-products-showcase__row {
      margin-block-start: var(--section-vertical-spacing, 2.5rem);
    }

    #shopify-section-{{ section.id }} .category-products-showcase__tile {
      position: relative;
      align-self: start;
      aspect-ratio: 1;
      isolation: isolate;
      border: 1px solid rgb(var(--text-color) / .12);
      border-radius: .25rem;
      background: rgb(var(--text-color) / .04);
      box-shadow: 0 10px 30px rgb(31 42 36 / .08);
      transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__tile:focus-visible {
      outline: 2px solid #b5812f;
      outline-offset: 3px;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__tile > .content {
      position: absolute;
      inset: auto 0 0;
      width: 100%;
      max-width: none;
      padding: 0;
      text-shadow: none;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      width: 100%;
      padding: .9rem 1rem;
      color: #30463b;
      background: rgb(255 255 255 / .94);
      backdrop-filter: blur(8px);
    }

    #shopify-section-{{ section.id }} .category-products-showcase__eyebrow {
      display: block;
      margin-block-end: .2rem;
      color: #a97524;
      font-size: .625rem;
      font-weight: 600;
      letter-spacing: .14em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__title {
      display: block;
      font-size: clamp(1rem, 1.35vw, 1.35rem);
      line-height: 1.15;
      letter-spacing: .04em;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
      text-transform: uppercase;
      white-space: nowrap;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__arrow {
      display: grid;
      flex: 0 0 2rem;
      width: 2rem;
      height: 2rem;
      place-items: center;
      color: #a97524;
      border: 1px solid rgb(169 117 36 / .5);
      border-radius: 50%;
      transition: color .25s ease, background-color .25s ease, transform .25s ease;
    }

    @media (hover: hover) {
      #shopify-section-{{ section.id }} .category-products-showcase__tile:hover {
        border-color: rgb(169 117 36 / .45);
        box-shadow: 0 14px 36px rgb(31 42 36 / .14);
        transform: translateY(-2px);
      }

      #shopify-section-{{ section.id }} .category-products-showcase__tile:hover .category-products-showcase__arrow {
        color: #fff;
        background: #30463b;
        transform: translateX(2px);
      }
    }

    {%- comment -%}
      Mobile: each category gets a full-width shopping card, followed by a contained
      horizontal product strip. The next product remains visible as a swipe cue without
      making the page itself wider than the viewport.
    {%- endcomment -%}
    @media screen and (max-width: 699px) {
      #shopify-section-{{ section.id }} .category-products-showcase__row {
        gap: 1rem;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__row > .category-products-showcase__tile {
        aspect-ratio: 4 / 3;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__products {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(148px, 72%);
        gap: .75rem;
        min-width: 0;
        max-width: 100%;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        padding-inline-end: 1rem;
        scroll-padding-inline: 0;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__products::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__products > * {
        scroll-snap-align: start;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__title {
        font-size: 1.2rem;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__cta {
        padding: .85rem 1rem;
      }
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} .category-products-showcase__row {
        grid-template-columns: repeat(var(--category-products-showcase-columns, 4), minmax(0, 1fr));
      }

      #shopify-section-{{ section.id }} .category-products-showcase__products {
        display: contents;
      }
    }
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
    <div class="container">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.heading,
          heading_style: section.settings.heading_style,
          content: section.settings.content
        -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign showcase_collection = block.settings.collection
            assign products_count = block.settings.products_count
            assign columns = products_count | plus: 1
          -%}

          {%- if showcase_collection != blank -%}
            <div class="category-products-showcase__row" style="--category-products-showcase-columns: {{ columns }};" {{ block.shopify_attributes }}>
              <a href="{{ showcase_collection.url }}" class="category-products-showcase__tile content-over-media color-scheme color-scheme--{{ block.settings.tile_color_scheme.id }} group" aria-label="Shop {{ block.settings.title | default: showcase_collection.title | escape }}">
                {%- liquid
                  assign tile_image = block.settings.image | default: showcase_collection.image
                -%}

                {%- if tile_image != blank -%}
                  {{- tile_image | image_url: width: tile_image.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 74vw, 25vw', widths: '400,600,800,1000,1200', class: 'zoom-image group-hover:zoom' -}}
                {%- else -%}
                  {%- capture collection_placeholder -%}{%- cycle 'collection-1', 'collection-2', 'collection-3' -%}{%- endcapture -%}
                  {{- collection_placeholder | placeholder_svg_tag: 'placeholder zoom-image group-hover:zoom' -}}
                {%- endif -%}

                <div class="content w-full align-self-end text-start">
                  <div class="category-products-showcase__cta">
                    <div>
                      <span class="category-products-showcase__eyebrow">Shop collection</span>
                      <span class="h3 category-products-showcase__title">{{ block.settings.title | default: showcase_collection.title }}</span>
                    </div>

                    <span class="category-products-showcase__arrow" aria-hidden="true">
                      {%- render 'icon' with 'arrow-right', width: 14, direction_aware: true -%}
                    </span>
                  </div>
                </div>
              </a>

              <div class="category-products-showcase__products">
                {%- for product in showcase_collection.products limit: products_count -%}
                  {%- render 'product-card', product: product, reveal: false, position: forloop.index, section: section -%}
                {%- else -%}
                  {%- for i in (1..products_count) -%}
                    {%- render 'product-card-placeholder', reveal: false, loop_index: forloop.index0 -%}
                  {%- endfor -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Category showcase",
  "class": "shopify-section--category-products-showcase",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category row",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_count",
          "min": 2,
          "max": 4,
          "default": 3,
          "label": "Products to show"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:global.text.heading",
          "info": "Falls back to the collection's own title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:global.image.image",
          "info": "Falls back to the collection's own image"
        },
        {
          "type": "color_scheme",
          "id": "tile_color_scheme",
          "label": "Tile text color scheme",
          "default": "scheme-2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category showcase",
      "category": "t:global.categories.storytelling",
      "blocks": [
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
