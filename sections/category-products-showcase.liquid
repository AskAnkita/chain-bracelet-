{%- comment -%}
  Z-pattern editorial layout: alternating lifestyle-image / product-grid
  columns per collection row.  Mobile stays stacked; desktop (≥ 990px) uses
  Flexbox with reversed rows on even iterations for the zig-zag.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <style>
    /* ── Section-level ──────────────────────────────────────── */
    #shopify-section-{{ section.id }} .section-header .h2 {
      color: #a97524;
    }

    /* ── Eyebrow ────────────────────────────────────────────── */
    #shopify-section-{{ section.id }} .category-products-showcase__eyebrow {
      display: block;
      margin-block-end: .25rem;
      color: #a97524;
      font-size: .625rem;
      font-weight: 600;
      letter-spacing: .14em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    /* ── Collection title ───────────────────────────────────── */
    #shopify-section-{{ section.id }} .category-products-showcase__title {
      display: block;
      font-size: clamp(1.1rem, 1.6vw, 1.5rem);
      line-height: 1.15;
      letter-spacing: .04em;
      text-transform: uppercase;
      margin: 0;
    }

    /* ── Lifestyle image column ─────────────────────────────── */
    #shopify-section-{{ section.id }} .category-products-showcase__image-col {
      position: relative;
      overflow: hidden;
      border-radius: .25rem;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__image-col a {
      display: block;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .category-products-showcase__image-col img,
    #shopify-section-{{ section.id }} .category-products-showcase__image-col svg {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform .45s ease;
    }

    @media (hover: hover) {
      #shopify-section-{{ section.id }} .category-products-showcase__image-col:hover img,
      #shopify-section-{{ section.id }} .category-products-showcase__image-col:hover svg {
        transform: scale(1.03);
      }
    }

    /* ── Product grid ───────────────────────────────────────── */
    #shopify-section-{{ section.id }} .category-products-showcase__product-grid {
      display: grid;
      grid-template-columns: repeat(var(--product-grid-cols, 2), 1fr);
      gap: 1rem;
      margin-top: 1.25rem;
    }

    /* ── "Shop All" CTA: the theme's standard button (gold, wipe on hover), centred ── */
    #shopify-section-{{ section.id }} .category-products-showcase__shop-all {
      align-self: center;
      margin-top: 1.25rem;
      text-align: center;
    }

    /* ── Mobile (< 990px) ── stacked layout preserved ───────── */
    @media screen and (max-width: 989px) {
      #shopify-section-{{ section.id }} .category-products-showcase__row {
        margin-bottom: 2.5rem;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__row:last-child {
        margin-bottom: 0;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__image-col {
        aspect-ratio: 4 / 3;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__content-col {
        margin-top: 1rem;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__product-grid {
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: minmax(148px, 72%);
        grid-template-columns: none;
        gap: .75rem;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        padding-inline-end: 1rem;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__product-grid::-webkit-scrollbar {
        display: none;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__product-grid > * {
        scroll-snap-align: start;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__title {
        font-size: 1.2rem;
      }
    }

    /* ── Desktop Z-pattern (≥ 990px) ────────────────────────── */
    @media screen and (min-width: 990px) {
      #shopify-section-{{ section.id }} .category-products-showcase__row {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 80px;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__row:last-child {
        margin-bottom: 0;
      }

      /* Even rows: image anchors the right side */
      #shopify-section-{{ section.id }} .category-products-showcase__row--reversed {
        flex-direction: row-reverse;
      }

      /* Hide lifestyle banner on desktop */
      #shopify-section-{{ section.id }} .category-products-showcase__image-col {
        display: none;
      }

      /* Content column — tighter layout */
      #shopify-section-{{ section.id }} .category-products-showcase__content-col {
        flex: 1 1 0%;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      #shopify-section-{{ section.id }} .category-products-showcase__product-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: .75rem;
      }
    }
  </style>

  {%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}

  <div class="section-spacing color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }} {% if section.settings.separate_section_with_border %}bordered-section{% endif %}">
    <div class="container">
      <div class="section-stack">
        {%- render 'section-header',
          subheading: section.settings.subheading,
          heading: section.settings.heading,
          heading_style: section.settings.heading_style,
          content: section.settings.content
        -%}

        {%- for block in section.blocks -%}
          {%- liquid
            assign showcase_collection = block.settings.collection
            assign products_count = block.settings.products_count
            assign grid_cols = products_count | at_most: 4
            assign is_even = forloop.index | modulo: 2
          -%}

          {%- if showcase_collection != blank -%}
            <div
              class="category-products-showcase__row {% if is_even == 0 %}category-products-showcase__row--reversed{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- comment -%} Lifestyle image column (~40 % on desktop) {%- endcomment -%}
              <div class="category-products-showcase__image-col">
                <a href="{{ showcase_collection.url }}" aria-label="Shop {{ block.settings.title | default: showcase_collection.title | escape }}">
                  {%- liquid
                    assign tile_image = block.settings.image | default: showcase_collection.image
                  -%}

                  {%- if tile_image != blank -%}
                    {{- tile_image | image_url: width: tile_image.width | image_tag: loading: 'lazy', sizes: '(max-width: 989px) 100vw, 40vw', widths: '400,600,800,1000,1200,1600' -}}
                  {%- else -%}
                    {%- capture collection_placeholder -%}{%- cycle 'collection-1', 'collection-2', 'collection-3' -%}{%- endcapture -%}
                    {{- collection_placeholder | placeholder_svg_tag: 'placeholder' -}}
                  {%- endif -%}
                </a>
              </div>

              {%- comment -%} Content column: header + product grid + CTA (~60 % on desktop) {%- endcomment -%}
              <div class="category-products-showcase__content-col">
                <span class="category-products-showcase__eyebrow">Shop Collection</span>
                <span class="h3 category-products-showcase__title">
                  {{- block.settings.title | default: showcase_collection.title -}}
                </span>

                <div
                  class="category-products-showcase__product-grid"
                  style="--product-grid-cols: {{ grid_cols }};"
                >
                  {%- for product in showcase_collection.products limit: products_count -%}
                    {%- render 'product-card', product: product, reveal: false, position: forloop.index, section: section -%}
                  {%- else -%}
                    {%- for i in (1..products_count) -%}
                      {%- render 'product-card-placeholder', reveal: false, loop_index: forloop.index0 -%}
                    {%- endfor -%}
                  {%- endfor -%}
                </div>

                <div class="category-products-showcase__shop-all">
                  {%- capture shop_all_label -%}Shop All {{ block.settings.title | default: showcase_collection.title }}{%- endcapture -%}
                  {%- render 'button', href: showcase_collection.url, content: shop_all_label -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Category showcase",
  "class": "shopify-section--category-products-showcase",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "header",
      "content": "t:global.section.header_category"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:global.text.subheading"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:global.text.heading"
    },
    {
      "type": "select",
      "id": "heading_style",
      "label": "t:global.text.style",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "t:global.text.content"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category row",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_count",
          "min": 2,
          "max": 4,
          "default": 4,
          "label": "Products to show"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:global.text.heading",
          "info": "Falls back to the collection's own title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:global.image.image",
          "info": "Falls back to the collection's own image"
        },
        {
          "type": "color_scheme",
          "id": "tile_color_scheme",
          "label": "Tile text color scheme",
          "default": "scheme-2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category showcase",
      "category": "t:global.categories.storytelling",
      "blocks": [
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
