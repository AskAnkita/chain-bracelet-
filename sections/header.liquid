{%- comment -%}
  Every page, including the home page, gets the compact single-row bar: logo hard
  left, menu centred, icons hard right, transparent over a hero and solid white on
  hover/scroll. Previously the home page kept a separate tall three-row masthead
  (about + icons, rule + mark, then wordmark + menu); that's now unused in favor of
  one consistent bar everywhere.
{%- endcomment -%}
{%- liquid
  assign compact_header = true
-%}

<style>
  :root {
    {%- comment -%}
      The compact bar is pinned below regardless of the merchant's sticky setting, so
      it has to report itself as sticky here too. --sticky-area-height is derived from
      this flag, and anything else that sticks (product info, collection toolbar) uses
      that to clear the header — leaving it at 0 would let them slide underneath.
    {%- endcomment -%}
    --header-is-sticky: {% if section.settings.enable_sticky or compact_header %}1{% else %}0{% endif %};
  }

  #shopify-section-{{ section.id }} {
    {%- comment -%}
      Both side columns are minmax(min-content, 1fr), not plain minmax(0, 1fr): this is
      the only grid definition in effect below 1000px (the overrides further down only
      kick in at 1000px+), and a floor of 0 let the icon row (search/account/wishlist/
      cart) get squeezed narrower than its own content on small phones -- the icons
      don't wrap, so they overflowed leftward out of their column and sat on top of the
      logo mark next to them. min-content stops that; keeping BOTH sides as 1fr (rather
      than making just secondary-nav `auto`, tried first) matters because that pair is
      what centers the logo mark between them -- an `auto` side plus a `1fr` side made
      the two tracks grow unevenly, which visibly dragged the mark off-center at
      tablet widths where there's slack to divide unevenly in the first place.
    {%- endcomment -%}
    --header-grid: "primary-nav logo secondary-nav" / minmax(min-content, 1fr) auto minmax(min-content, 1fr);
    --header-padding-block: 1rem;
    --header-transparent-header-text-color: {{ section.settings.transparent_header_text_color.rgb }};
    {%- comment -%}
      Scrim painted behind the header while it sits over a hero image, so the links
      stay readable against a busy photo. Alpha 0 gives the fully see-through header.
    {%- endcomment -%}
    --header-overlay: {{ section.settings.transparent_overlay_color.rgb }} / {{ section.settings.transparent_overlay_opacity | divided_by: 100.0 }};
    --header-separation-border-color: {% if section.settings.show_separation_border %}{{ section.settings.color_scheme.settings.text_color.rgb }} / 0.15{% else %}0 0 0 / 0{% endif %};

    position: relative;
    z-index: 4;
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      --header-padding-block: {% if section.settings.reduce_padding %}1.2rem{% else %}1.6rem{% endif %};
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      --header-padding-block: 2rem;
      {%- case section.settings.layout -%}
        {%- when 'logo_left_navigation_inline' -%}
          --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto;

        {%- when 'logo_left_navigation_center' -%}
          --header-grid: "logo primary-nav secondary-nav" / minmax(max-content, 1fr) auto minmax(max-content, 1fr);

        {%- when 'logo_center_navigation_inline' -%}
          --header-grid: "primary-nav logo secondary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);

        {%- when 'logo_center_navigation_below' -%}
          --header-grid: ". logo secondary-nav" "primary-nav primary-nav primary-nav" / minmax(0, 1fr) auto minmax(0, 1fr);
      {%- endcase -%}
    }
  }


  {%- if section.settings.enable_sticky -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }
  {%- endif -%}

  {%- comment -%}Utility rows (about + icons, then rules + mark).{%- endcomment -%}
  #shopify-section-{{ section.id }} .header__utility {
    {%- comment -%}
      The utility rows are a sibling of .header, not a child, so theme.css's default
      on .header never reaches them. Declared here so the mark's two icons have a
      base state to swap from; the transparent rule further down flips it to 1.
    {%- endcomment -%}
    --header-show-transparent-logo: 0;
    background: rgb(var(--background));
    color: rgb(var(--text-color));
    position: relative;
    z-index: 5;
    font-size: {{ section.settings.utility_text_size }}rem;
    letter-spacing: .16em;
    text-transform: uppercase;
    transition: background .2s, color .2s;
  }

  #shopify-section-{{ section.id }} .header__utility-row {
    display: flex;
    align-items: center;
    padding-inline: var(--container-gutter);
  }

  #shopify-section-{{ section.id }} .header__utility-row--top {
    justify-content: space-between;
    gap: 1rem;
    padding-block: {{ section.settings.utility_padding }}rem calc({{ section.settings.utility_padding }}rem / 2);
  }

  #shopify-section-{{ section.id }} .header__utility-row--rule {
    gap: 1.5rem;
    padding-block-end: calc({{ section.settings.utility_padding }}rem / 2);
  }

  {%- comment -%}
    Space between the mark row and the menu row. Set here rather than via
    --header-padding-block, which theme.css also uses for the header's bottom
    padding and grid row-gap; this keeps the two independently adjustable.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} .header {
    padding-block-start: {{ section.settings.menu_top_space }}rem;
  }

  #shopify-section-{{ section.id }} .header__utility-rule {
    flex: 1 1 auto;
    height: 1px;
    background: rgb(var(--text-color) / .15);
  }

  #shopify-section-{{ section.id }} .header__utility-mark {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    position: relative;
  }

  #shopify-section-{{ section.id }} .header__utility-mark :is(img, svg) {
    width: {{ section.settings.center_icon_width }}px;
    height: auto;
    display: block;
  }

  {%- comment -%}
    Same two-image cross-fade theme.css uses for the wordmark: both marks are stacked,
    and --header-show-transparent-logo drives which one is opaque. The :not(:only-of-type)
    guard means a mark with no transparent counterpart stays at full opacity.
  {%- endcomment -%}
  #shopify-section-{{ section.id }} :is(.header__utility-mark, .header__compact-mark) .header__mark-image:where(:not(:only-of-type)) {
    opacity: calc(1 - var(--header-show-transparent-logo));
    transition: opacity .2s;
  }

  #shopify-section-{{ section.id }} :is(.header__utility-mark, .header__compact-mark) .header__mark-image--transparent {
    opacity: var(--header-show-transparent-logo);
    pointer-events: none;
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
  }

  {%- comment -%}The icon row moved out of x-header, so it lays itself out here.{%- endcomment -%}
  #shopify-section-{{ section.id }} .header__utility .header__secondary-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    grid-area: auto;
    justify-self: auto;
  }

  #shopify-section-{{ section.id }} .header__utility .header__nav-icon {
    width: {{ section.settings.utility_icon_size }}px;
    height: auto;
  }

  #shopify-section-{{ section.id }} .header__utility-badge {
    position: absolute;
    inset-block-start: -.45rem;
    inset-inline-end: -.6rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding-inline: .15rem;
    /* Fixed, not scheme-derived, so counts stay legible over a photo too. */
    background: #1c1c1c;
    color: #fff;
    border-radius: 999px;
    font-size: .55rem;
    letter-spacing: 0;
    line-height: 1.05rem;
    text-align: center;
  }

  {%- comment -%}
    Hover is scoped to the whole section, not to each row. theme.css tests :hover on
    .header alone, so pointing at the utility rows used to flip only those to solid
    while the menu row stayed transparent. Keying both off the section means every
    row changes together, as one navbar.

    Both rows paint the same --header-overlay scrim, so they read as one tinted band
    over the hero rather than two separately-shaded strips.
  {%- endcomment -%}
  :has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) #shopify-section-{{ section.id }}:not(:hover) .header__utility {
    --header-show-transparent-logo: 1;
    background: rgb(var(--header-overlay));
    color: rgb(var(--header-transparent-header-text-color));
  }

  :has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) #shopify-section-{{ section.id }}:not(:hover) .header__utility .header__utility-rule {
    background: rgb(var(--header-transparent-header-text-color) / .3);
  }

  {%- comment -%}
    x-header adds .is-solid once #header-scroll-tracker leaves the viewport, and
    theme.css drops transparency for that class — which makes the bar flash white
    as it scrolls away. The header is not sticky, so that solid state serves no
    purpose here. This keeps every row transparent while scrolling, and still lets
    an open dropdown or the search drawer force solid (kept from the theme's rule).
  {%- endcomment -%}
  :has(.shopify-section:first-child [allow-transparent-header]):not(:has(.shopify-section--header ~ .shopify-section-group-header-group)) #shopify-section-{{ section.id }}:not(:hover) .header:not(:has(.header__primary-nav [open], .header__secondary-nav [open], .header-search[open])) {
    --header-show-transparent-logo: 1;
    --header-separation-border-color: 0 0 0 / 0;
    --background: var(--header-overlay);
    --background-gradient: 0 0 0 / 0;
    --border-color: 0 0 0 / 0;
    --text-color: var(--header-transparent-header-text-color);
  }

  {%- comment -%}
    The other half of the same problem: theme.css keeps .header transparent whenever
    .header itself is not hovered, so hovering the utility rows left the menu row
    see-through. This restores the scheme's solid colors on .header the moment any
    part of the section is hovered. It carries an id, so it outranks that rule.
  {%- endcomment -%}
  {%- assign header_scheme = section.settings.color_scheme -%}
  #shopify-section-{{ section.id }}:hover .header,
  #shopify-section-{{ section.id }}:hover .header__utility {
    --header-show-transparent-logo: 0;
    --background: {{ header_scheme.settings.background.rgb }} / {{ header_scheme.settings.background.alpha }};
    --text-color: {{ header_scheme.settings.text_color.rgb }};

    background: rgb(var(--background));
    color: rgb(var(--text-color));
  }

  {%- if compact_header -%}
    {%- comment -%}
      Compact bar. These fight the layout rules in theme.liquid, which are written as
      `#shopify-section-… x-header { … !important }`. Carrying the same id plus the
      .header-compact class outranks them, so the wordmark grid does not leak in here.

      The bar is also pinned, so the menu stays reachable on long inner pages. That is
      scoped here rather than flipping the merchant's `enable_sticky`, which would pin
      the tall home masthead too.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
    }

    .shopify-section--announcement-bar ~ #shopify-section-{{ section.id }} {
      top: calc(var(--announcement-bar-is-sticky, 0) * var(--announcement-bar-height, 0px));
    }

    {%- comment -%}
      theme.css gives .header equal top/bottom padding via --header-padding-block.
      This used to zero out just the top half, which is what pinned the bar's
      content flush against the very top edge with no breathing room -- the bottom
      kept its padding, so the row read as bottom-heavy. Matching top to bottom
      here gives it the same symmetric spacing as the home sticky bar.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .header-compact .header {
      padding-block-start: var(--header-padding-block);
    }

    {%- comment -%}
      Inner pages have no hero to gate transparency behind, and the bar IS the site's
      only nav on these pages, so it starts transparent unconditionally rather than
      waiting for a [allow-transparent-header] section like the home masthead does.
      Same open-menu/open-search exclusion as that rule, so an open dropdown still
      forces solid and stays readable.
    {%- endcomment -%}
    #shopify-section-{{ section.id }}:not(:hover) .header-compact .header:not(:has(.header__primary-nav [open], .header__secondary-nav [open], .header-search[open])) {
      --header-show-transparent-logo: 1;
      --header-separation-border-color: 0 0 0 / 0;
      --background: 0 0 0 / 0;
      --background-gradient: 0 0 0 / 0;
      --border-color: 0 0 0 / 0;
      --text-color: var(--header-transparent-header-text-color);
    }

    {%- comment -%}
      x-header adds .is-solid once #header-scroll-tracker leaves the viewport. On the
      home page that state is suppressed further down (the masthead is not pinned, so
      it only caused a flash on the way out). Here the bar IS pinned, so the scrolled
      state is the point: it drops the transparency for a white background once the
      page moves under it. Beats the transparent rule above, which does not exclude
      .is-solid, and also restores the scheme's normal text color -- that rule sets
      --text-color to the transparent (white) value and nothing else in this state
      was resetting it back.
    {%- endcomment -%}
    #shopify-section-{{ section.id }} .header-compact .header.is-solid {
      --header-show-transparent-logo: 0 !important;
      --header-separation-border-color: {% if section.settings.show_separation_border %}{{ section.settings.color_scheme.settings.text_color.rgb }} / 0.15{% else %}0 0 0 / 0{% endif %} !important;
      --background: 255 255 255 !important;
      --background-gradient: 0 0 0 / 0 !important;
      --text-color: {{ header_scheme.settings.text_color.rgb }} !important;

      background: rgb(255 255 255) !important;
      color: rgb(var(--text-color)) !important;
    }

    {%- comment -%}The mark and icons sit in the menu row's own grid areas.{%- endcomment -%}
    #shopify-section-{{ section.id }} .header-compact .header__compact-mark {
      grid-area: logo;
      grid-row: 1;
      align-self: center;
      justify-self: start;
      display: flex;
      align-items: center;
      position: relative;
    }

    {%- comment -%}
      The mark is a lone brand cue in a single-row bar here, not the centrepiece of a
      three-row masthead, so it's sized to fill the bar's height rather than pinned to
      a small width -- the merchant's logo file is roughly square, so a width cap left
      it far shorter than the nav links beside it. Driving it by height instead makes
      it match the nav row; width follows the image's aspect ratio. Still derived from
      the merchant's center_icon width setting so it tracks that knob, just read as a
      height now. The width cap is a safety rail for very wide logo files.
    {%- endcomment -%}
    {%- assign compact_mark_height = section.settings.center_icon_width | times: 1.1 | round -%}
    #shopify-section-{{ section.id }} .header-compact .header__compact-mark :is(img, svg) {
      height: {{ compact_mark_height }}px;
      width: auto;
      max-width: {{ section.settings.center_icon_width | times: 3 | round }}px;
      object-fit: contain;
      display: block;
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .header-compact .header__compact-mark :is(img, svg) {
        height: {{ section.settings.center_icon_width | times: 1.35 | round }}px;
      }
    }

    #shopify-section-{{ section.id }} .header-compact .header__secondary-nav {
      grid-row: 1;
      align-self: center;
      flex-wrap: nowrap;
      gap: 1.5rem;
    }

    #shopify-section-{{ section.id }} .header-compact .header__nav-icon {
      width: {{ section.settings.utility_icon_size }}px;
      height: auto;
    }

    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} .header-compact x-header {
        --header-grid: "logo primary-nav secondary-nav" / auto minmax(0, 1fr) auto !important;
        --header-padding-block: 1.2rem !important;
        align-items: center !important;
      }

      #shopify-section-{{ section.id }} .header-compact .header__primary-nav {
        grid-area: primary-nav !important;
        grid-column: primary-nav !important;
        grid-row: 1 !important;
        align-self: center !important;
        padding-block: 0 !important;
        pointer-events: auto !important;
      }

      #shopify-section-{{ section.id }} .header-compact .header__primary-nav :is(ul, menu) {
        gap: 2rem !important;
        max-width: none !important;
        flex-wrap: nowrap;
      }

      {%- comment -%}
        No centred wordmark to make room for, so close the gap theme.liquid opens
        after the second link.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .header-compact .header__primary-nav :is(ul, menu) > li:nth-child(2) {
        margin-inline-end: 0 !important;
      }
    }
  {%- endif -%}

  {%- if section.settings.logo != blank -%}
    #shopify-section-{{ section.id }} {
      --header-logo-width: {{ section.settings.logo_mobile_max_width }}px;
    }

    @media screen and (min-width: 700px) {
      #shopify-section-{{ section.id }} {
        --header-logo-width: {{ section.settings.logo_max_width }}px;
      }
    }
  {%- endif -%}
</style>

<height-observer variable="header" {% if compact_header %}class="header-compact"{% endif %}>
  {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    UTILITY ROWS (row 1: about + icons, row 2: rules + mark)

    These live inside the same height-observer as x-header, so --header-height covers
    all three rows and theme.css's own transparent-header margin pulls the hero up by
    the full amount with no override needed.

    Home page only. On the compact bar the icon nav is captured below and re-emitted
    inside x-header instead, so it lands in that row's `secondary-nav` grid area.
    --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- liquid
    if section.settings.show_country_selector and localization.available_countries.size > 1
      assign show_country_selector = true
    endif

    if section.settings.show_locale_selector and localization.available_languages.size > 1
      assign show_locale_selector = true
    endif
  -%}

  {%- capture secondary_nav -%}
      <nav class="header__secondary-nav" aria-label="{{ 'header.general.secondary_navigation' | t | escape }}">
        <ul class="contents unstyled-list">
          {%- if show_country_selector or show_locale_selector -%}
            <li class="localization-selectors md-max:hidden">
              {%- if show_country_selector -%}
                {%- render 'localization-selector',
                  type: 'country',
                  placement: 'bottom-end',
                  show_country_name: section.settings.show_country_name,
                  show_country_flag: section.settings.show_country_flag,
                  id_prefix: 'header-nav'
                -%}
              {%- endif -%}

              {%- if show_locale_selector -%}
                {%- render 'localization-selector', type: 'locale', placement: 'bottom-end', id_prefix: 'header-nav' -%}
              {%- endif -%}
            </li>
          {%- endif -%}

          {%- comment -%}Offer a hook for apps to integrate into the header to add their own icon, for instance{%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <li>
                {%- render block -%}
              </li>
            {%- endif -%}
          {%- endfor -%}

          {%- if section.settings.enable_search -%}
            <li class="header__search-link">
              <a href="{{ routes.search_url }}" aria-controls="header-search-{{ section.id }}">
                <span class="sr-only">{{ 'header.general.search' | t }}</span>
                {%- render 'icon' with 'search', class: 'header__nav-icon' -%}
              </a>
            </li>
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            <li class="header__account-link">
              <shopify-account menu="{{ section.settings.customer_account_menu }}">
                <div slot="signed-out-avatar">
                  {%- render 'icon' with 'account', class: 'header__nav-icon' -%}
                </div>
              </shopify-account>
            </li>
          {%- endif -%}

          {%- if section.settings.show_wishlist -%}
            <li class="relative header__wishlist-link">
              <a href="{{ section.settings.wishlist_url | default: '#' }}">
                <span class="sr-only">{{ section.settings.wishlist_label | default: 'Wishlist' }}</span>
                {%- render 'icon' with 'wishlist', class: 'header__nav-icon' -%}
                <wishlist-count class="header__utility-badge"></wishlist-count>
              </a>
            </li>
          {%- endif -%}

          <li class="relative header__cart-link">
            <a
              href="{{ routes.cart_url }}"
              {% if settings.cart_type != 'page' and request.page_type != 'cart' %}
                aria-controls="cart-drawer"
              {% endif %}
              data-no-instant
            >
              <span class="sr-only">{{ 'header.general.cart' | t }}</span>
              {%- render 'icon' with 'cart', class: 'header__nav-icon' -%}
              <cart-count class="header__utility-badge">{{ cart.item_count }}</cart-count>
            </a>
          </li>
        </ul>
      </nav>
  {%- endcapture -%}

  {%- unless compact_header -%}
    <div class="header__utility color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
      <div class="header__utility-row header__utility-row--top">
        {%- if section.settings.about_label != blank -%}
          <a href="{{ section.settings.about_url | default: '#' }}" class="header__utility-about">
            {{- section.settings.about_label -}}
          </a>
        {%- else -%}
          <span></span>
        {%- endif -%}

        {{ secondary_nav }}
      </div>

      <div class="header__utility-row header__utility-row--rule">
        <span class="header__utility-rule" aria-hidden="true"></span>

        <a href="{{ routes.root_url }}" class="header__utility-mark" aria-label="{{ shop.name }}">
          {%- if section.settings.center_icon -%}
            {{- section.settings.center_icon | image_url: width: 80 | image_tag: widths: '40,80', alt: shop.name, loading: 'lazy', class: 'header__mark-image' -}}

            {%- comment -%}
              The light mark for the transparent header. Decorative: the <a> carries the
              label and the solid mark above already names the shop, so alt stays empty.
            {%- endcomment -%}
            {%- if section.settings.transparent_center_icon -%}
              {{- section.settings.transparent_center_icon | image_url: width: 80 | image_tag: widths: '40,80', alt: '', loading: 'lazy', class: 'header__mark-image header__mark-image--transparent' -}}
            {%- endif -%}
          {%- else -%}
            {%- render 'icon' with 'gem' -%}
          {%- endif -%}
        </a>

        <span class="header__utility-rule" aria-hidden="true"></span>
      </div>
    </div>
  {%- endunless -%}

  <x-header
    {% if section.settings.hide_on_scroll and section.settings.enable_sticky %}
      hide-on-scroll
    {% endif %}
    class="header color-scheme color-scheme--{{ section.settings.color_scheme.id }}"
  >
    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      LOGO AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- capture logo_content -%}
      {%- if section.settings.logo -%}
        {%- capture sizes -%}{{ section.settings.logo_max_width }}px{%- endcapture -%}
        {%- capture widths -%}{{ section.settings.logo_max_width | times: 2 | at_most: section.settings.logo.width }}, {{ section.settings.logo_max_width | times: 3 | at_most: section.settings.logo.width }}{%- endcapture -%}

        <span class="sr-only">{{ shop.name }}</span>
        {%- assign alt_text = section.settings.logo.alt | default: shop.name -%}
        {{- section.settings.logo | image_url: width: section.settings.logo.width | image_tag: sizes: sizes, alt: alt_text, widths: widths, class: 'header__logo-image' -}}

        {%- if section.settings.transparent_logo -%}
          {{- section.settings.transparent_logo | image_url: width: section.settings.transparent_logo.width | image_tag: sizes: sizes, widths: widths, class: 'header__logo-image header__logo-image--transparent' -}}
        {%- endif -%}
      {%- else -%}
        <span class="header__logo-text h5">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    {%- endcapture -%}
    {% comment %} <a href="{{ routes.root_url }}" class="header-scroll-logo" aria-label="{{ shop.name }}">
      <img
        src="https://cdn.shopify.com/s/files/1/0848/8380/0307/files/chain-and-bracelet-icon-green.svg?v=1787118452"
        alt="{{ shop.name }}"
        width="32"
        height="32"
      >
    </a> {% endcomment %}

    {%- if compact_header -%}
      {%- comment -%}
        The compact bar drops the wordmark for the small mark, which is what lets the
        three rows collapse into one. Same source as the utility mark on the home page:
        the merchant's center_icon when they have set one, the theme's gem otherwise.
      {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="header__compact-mark" aria-label="{{ shop.name }}">
        {%- if section.settings.center_icon -%}
          {{- section.settings.center_icon | image_url: width: 80 | image_tag: widths: '40,80', alt: shop.name, loading: 'lazy', class: 'header__mark-image' -}}

          {%- if section.settings.transparent_center_icon -%}
            {{- section.settings.transparent_center_icon | image_url: width: 80 | image_tag: widths: '40,80', alt: '', loading: 'lazy', class: 'header__mark-image header__mark-image--transparent' -}}
          {%- endif -%}
        {%- else -%}
          {%- render 'icon' with 'gem' -%}
        {%- endif -%}
      </a>
    {%- else -%}
      <h1 class="header__logo">
        <a href="{{ routes.root_url }}">{{ logo_content }}</a>
      </h1>
    {%- endif -%}

    {%- comment -%}
      --------------------------------------------------------------------------------------------------------------------
      PRIMARY NAVIGATION AREA
      --------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign menu = section.settings.menu -%}
    {%- assign sidebar_menu = section.settings.sidebar_menu -%}

    {%- if menu.links.size > 0 or sidebar_menu.links.size > 0 -%}
      <nav
        class="header__primary-nav {% if section.settings.layout == 'logo_center_navigation_below' or section.settings.layout == 'logo_left_navigation_center' %}header__primary-nav--center{% endif %}"
        aria-label="{{ 'header.general.primary_navigation' | t | escape }}"
      >
        <button
          type="button"
          aria-controls="sidebar-menu"
          {% unless section.settings.layout == 'drawer' %}
            class="md:hidden"
          {% endunless %}
        >
          <span class="sr-only">{{ 'header.general.menu' | t }}</span>
          {%- render 'icon' with 'hamburger', class: 'header__nav-icon' -%}
        </button>

        {%- if section.settings.layout != 'drawer' -%}
          <ul class="contents unstyled-list md-max:hidden">
            {%- comment -%}Render luxury mega menu blocks that don't have a menu_item set (standalone){%- endcomment -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'luxury_mega_menu' and block.settings.menu_item == blank -%}
                <li class="header__primary-nav-item">
                  {%- render 'luxury-mega-menu', block: block -%}
                </li>
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%}Left nav items (Necklaces, Bracelets){%- endcomment -%}
            {%- assign left_nav_items = "NECKLACES|/collections/necklaces,BRACELETS|/collections/bracelets" | split: "," -%}
            {%- for item in left_nav_items -%}
              {%- assign item_parts = item | split: "|" -%}
              {%- assign link_title = item_parts[0] -%}
              {%- assign link_url = item_parts[1] -%}
              {% liquid
                assign link_title_downcase = link_title | strip | downcase
                assign luxury_mega_menu_block = ''
                for block in section.blocks
                  assign block_menu_item_downcase = block.settings.menu_item | strip | downcase
                  if block.type == 'luxury_mega_menu'
                    if block_menu_item_downcase == link_title_downcase
                      assign luxury_mega_menu_block = block
                      break
                    endif
                  endif
                endfor
              %}
              <li class="header__primary-nav-item">
                <a href="{{ link_url }}" data-title="{{ link_title | escape }}" class="block {% if section.settings.menu_text_font == 'heading' %}h6{% endif %}">{{- link_title -}}</a>
              </li>
            {%- endfor -%}

            {%- comment -%}Right nav items (Rings, Earrings, Size Guide){%- endcomment -%}
            {%- assign right_nav_items = "RINGS|/collections/rings,EARRINGS|/collections/earrings,SIZE GUIDE|/pages/size-guide" | split: "," -%}
            {%- for item in right_nav_items -%}
              {%- assign item_parts = item | split: "|" -%}
              {%- assign link_title = item_parts[0] -%}
              {%- assign link_url = item_parts[1] -%}
              {% liquid
                assign link_title_downcase = link_title | strip | downcase
                assign luxury_mega_menu_block = ''
                for block in section.blocks
                  assign block_menu_item_downcase = block.settings.menu_item | strip | downcase
                  if block.type == 'luxury_mega_menu'
                    if block_menu_item_downcase == link_title_downcase
                      assign luxury_mega_menu_block = block
                      break
                    endif
                  endif
                endfor
              %}
              <li class="header__primary-nav-item">
                <a href="{{ link_url }}" data-title="{{ link_title | escape }}" class="block {% if section.settings.menu_text_font == 'heading' %}h6{% endif %}">{{- link_title -}}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>
    {%- endif -%}

    {%- comment -%}
      On the compact bar the icon nav belongs to this row, where theme.css's
      `grid-area: secondary-nav` puts it hard right beside the menu.
    {%- endcomment -%}
    {%- if compact_header -%}
      {{ secondary_nav }}
    {%- endif -%}

    {%- if section.settings.enable_search -%}
      {%- render 'header-search', section: section -%}
    {%- endif -%}

    {%- assign sidebar_menu = section.settings.sidebar_menu | default: section.settings.menu -%}

    {%- if sidebar_menu.links.size > 0 -%}
      {%- render 'header-sidebar',
        menu: sidebar_menu,
        color_scheme: section.settings.sidebar_color_scheme,
        show_dividers: section.settings.sidebar_show_dividers,
        open_second_level_menus: section.settings.sidebar_open_second_level_menus
      -%}
    {%- endif -%}
  </x-header>
</height-observer>

<script>
  document.documentElement.style.setProperty(
    '--header-height',
    `${document.getElementById('shopify-section-{{ section.id }}').clientHeight.toFixed(2)}px`
  );
</script>

{%- if section.settings.show_wishlist -%}
  <script>
    if (!customElements.get('wishlist-count')) {
      class WishlistCount extends HTMLElement {
        connectedCallback() {
          this.update = this.update.bind(this);
          this.update();
          window.addEventListener('storage', this.update);
          document.addEventListener('wishlist:updated', this.update);
        }

        disconnectedCallback() {
          window.removeEventListener('storage', this.update);
          document.removeEventListener('wishlist:updated', this.update);
        }

        update() {
          let count = 0;
          try {
            const stored = JSON.parse(localStorage.getItem('wishlist') || '[]');
            count = Array.isArray(stored) ? stored.length : 0;
          } catch (error) {
            count = 0;
          }
          this.textContent = count;
        }
      }

      customElements.define('wishlist-count', WishlistCount);
    }
  </script>
{%- endif -%}

