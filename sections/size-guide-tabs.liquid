<script>
  (function () {
    if (customElements.get('content-tabs-split')) return;

    // length explorer chips in the designed necklace/bracelet tabs: highlight the matching
    // chip, detail card and illustration line (everything sharing that data-index)
    document.addEventListener('input', function (e) {
      var finder = e.target.closest('[data-sg-finder]');
      if (!finder || e.target.tagName !== 'INPUT') return;
      var col = parseInt(finder.getAttribute('data-column'), 10);
      var value = parseFloat(e.target.value);
      var heads = finder.querySelectorAll('thead th');
      var best = null;
      var bestDiff = Infinity;
      finder.querySelectorAll('tbody tr').forEach(function (tr) {
        tr.classList.remove('is-match');
        var cell = tr.children[col];
        var diff = cell ? Math.abs(parseFloat(cell.textContent) - value) : NaN;
        if (diff < bestDiff) { bestDiff = diff; best = tr; }
      });
      var out = finder.querySelector('.sg-lg__finder-result');
      if (!best || isNaN(value) || bestDiff > 3) { out.textContent = ''; return; }
      best.classList.add('is-match');
      out.textContent = Array.prototype.slice.call(best.children, 0, Math.min(3, col)).map(function (td, i) {
        return (heads[i] ? heads[i].textContent.trim() + ' ' : '') + td.textContent.trim();
      }).join(' · ');
    });

    document.addEventListener('click', function (e) {
      var chip = e.target.closest('.sg-lg__chip');
      if (!chip) return;
      var explorer = chip.closest('[data-sg-explorer]');
      explorer.querySelectorAll('[data-index]').forEach(function (el) {
        var on = el.getAttribute('data-index') === chip.getAttribute('data-index');
        el.classList.toggle('is-active', on);
        if (el.classList.contains('sg-lg__chip')) el.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    });

    var ICONS = {
      ring: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="14" r="7"/><path d="M9 5.5 12 8l3-2.5L13.5 3h-3z"/></svg>',
      wrist: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="12" rx="8" ry="5.5"/><path d="M4 12a8 5.5 0 0 0 16 0" stroke-dasharray="1.5 2.5"/></svg>',
      necklace: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4c0 8 3.5 13 8 13s8-5 8-13"/><circle cx="12" cy="18.5" r="2"/></svg>',
      pendant: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5c3 3 6 4.5 8 4.5S17 8 20 5"/><path d="M12 9.5V13"/><path d="M12 21c2.2 0 4-1.8 4-4s-4-4-4-4-4 1.8-4 4 1.8 4 4 4z"/></svg>',
      earring: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 4a3 3 0 0 1 6 0c0 2-3 2.5-3 5"/><circle cx="12" cy="15" r="5"/></svg>',
      ruler: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="8" width="20" height="8" rx="1"/><path d="M7 8v3M12 8v4M17 8v3"/></svg>'
    };

    var diagRoot = document.getElementById('sg-diagrams-{{ section.id }}');
    var dropPendant = !!(diagRoot && diagRoot.hasAttribute('data-drop-pendant'));

    function keyFor(text) {
      var t = (text || '').toLowerCase();
      if (t.indexOf('ring') > -1 && t.indexOf('earring') === -1) return 'ring';
      if (t.indexOf('bracelet') > -1 || t.indexOf('bangle') > -1) return 'wrist';
      if (t.indexOf('pendant') > -1) return 'pendant';
      if (t.indexOf('necklace') > -1 || t.indexOf('chain') > -1) return 'necklace';
      if (t.indexOf('earring') > -1 || t.indexOf('hoop') > -1) return 'earring';
      return null;
    }

    var uid = 0;

    customElements.define('content-tabs-split', class extends HTMLElement {
      connectedCallback() {
        if (this._done) return;
        var heads = Array.prototype.filter.call(this.children, function (el) { return el.tagName === 'H2'; });
        if (heads.length < 2) return;
        this._done = true;
        uid += 1;

        var nodes = Array.prototype.slice.call(this.childNodes);
        var intro = document.createElement('div');
        intro.className = 'sg__intro';
        var panels = [];
        var current = null;

        nodes.forEach(function (node) {
          if (node.nodeType === 1 && node.tagName === 'H2') {
            // the Pendants tab is covered inside the designed Necklaces tab -- drop it and its copy
            if (dropPendant && keyFor(node.textContent) === 'pendant' && !/necklace/i.test(node.textContent)) {
              current = document.createElement('div');
              return;
            }
            // a trailing heading that isn't a jewellery category (e.g. "Still not sure?")
            // folds into the previous tab instead of getting its own
            if (panels.length && !keyFor(node.textContent)) {
              var last = panels[panels.length - 1];
              last.folded = last.folded || node;
              current = last.el;
              current.appendChild(node);
              return;
            }
            current = document.createElement('div');
            current.className = 'sg__panel';
            current.setAttribute('role', 'tabpanel');
            current.appendChild(node);
            panels.push({ el: current, title: node.textContent.trim() });
          } else if (current) {
            current.appendChild(node);
          } else {
            intro.appendChild(node);
          }
        });

        // drop leftover "[ add image ... ]" placeholder lines from the pasted copy
        [intro].concat(panels.map(function (p) { return p.el; })).forEach(function (container) {
          Array.prototype.slice.call(container.querySelectorAll('p, div, figure')).forEach(function (el) {
            if (/\[\s*(add|insert)\b[^\]]*image[^\]]*\]/i.test(el.textContent || '')) el.remove();
          });
        });

        this.textContent = '';
        if (intro.childNodes.length) this.appendChild(intro);

        var tablist = document.createElement('ul');
        tablist.className = 'sg__tablist';
        tablist.setAttribute('role', 'tablist');

        panels.forEach(function (p, i) {
          var id = 'sg-' + uid + '-' + i;
          var key = keyFor(p.title);

          var li = document.createElement('li');
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'sg__tab';
          btn.id = id + '-tab';
          btn.setAttribute('role', 'tab');
          btn.setAttribute('aria-controls', id);
          btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
          btn.innerHTML = (ICONS[key] || ICONS.ruler) + '<span>' + p.title + '</span>';
          li.appendChild(btn);
          tablist.appendChild(li);

          p.el.id = id;
          p.el.setAttribute('aria-labelledby', id + '-tab');
          p.el.hidden = i !== 0;

          var tpl = key && diagRoot ? diagRoot.querySelector('template[data-key="' + key + '"]') : null;
          if (tpl) {
            // a data-replace template stands in for the tab's own copy (up to any folded-in trailing heading)
            if (tpl.hasAttribute('data-replace')) {
              var heading = p.el.firstChild;
              while (heading.nextSibling && heading.nextSibling !== p.folded) {
                p.el.removeChild(heading.nextSibling);
              }
            }
            p.el.insertBefore(tpl.content.cloneNode(true), p.el.children[1] || null);
          }

          btn.addEventListener('click', function () { select(i); });
          btn.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % panels.length, true); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + panels.length) % panels.length, true); }
          });
        });

        this.appendChild(tablist);
        panels.forEach(function (p) { this.appendChild(p.el); }, this);

        var self = this;
        function select(idx, focus) {
          panels.forEach(function (p, i) {
            p.el.hidden = i !== idx;
            var tab = self.querySelector('#' + p.el.id + '-tab');
            tab.setAttribute('aria-selected', i === idx ? 'true' : 'false');
            if (i === idx && focus) tab.focus();
          });
        }
      }
    });
  })();
</script>
{% schema %}
{
  "name": "Size guide tabs",
  "class": "shopify-section--size-guide-tabs",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Content width",
      "options": [
        {
          "value": "sm",
          "label": "Small"
        },
        {
          "value": "md",
          "label": "Medium"
        },
        {
          "value": "lg",
          "label": "Large"
        }
      ],
      "default": "md"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "info": "Active tab underline, step numbers and measurement arrows.",
      "default": "#b08d57"
    },
    {
      "type": "header",
      "content": "Illustrations",
      "info": "Each category ships with a line drawing. Upload an image to replace it."
    },
    {
      "type": "range",
      "id": "illustration_width",
      "min": 180,
      "max": 480,
