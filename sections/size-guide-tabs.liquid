{%- comment -%}
  Size guide page.

  Renders the page's own content (edited in Admin -> Content -> Pages) and, where
  JavaScript is available, turns each <h2> into a switchable tab. Into each tab it
  injects a "how to measure" card -- three short steps plus an illustration -- so
  every category reads the same way. With no JS it degrades to a stacked article.

  The illustrations are inline SVG by default; each category also has an image
  picker in the theme editor that replaces its SVG with your own artwork.

  It also forces the header to a solid white background -- but only on whatever
  template uses this section, because the section's <style> only loads there.
{%- endcomment -%}

<style>
  /* ---- Solid white header, this template only ---- */
  .header,
  .header__utility {
    --background: 255 255 255 / 1 !important;
    --background-gradient: 0 0 0 / 0 !important;
    --text-color: 28 28 28 !important;
    --header-transparent-header-text-color: 28 28 28 !important;
    --header-overlay: 255 255 255 / 1 !important;
    --header-show-transparent-logo: 0 !important;
    --header-separation-border-color: 0 0 0 / 0.10 !important;
  }

  #shopify-section-{{ section.id }} {
    --sg-accent: {{ section.settings.color_scheme.settings.text_color.rgb }};
    --sg-surface: {{ section.settings.color_scheme.settings.background.rgb }};
    --sg-gold: {{ section.settings.accent_color }};
    --sg-line: rgb(var(--sg-accent) / .12);
    --sg-tint: rgb(var(--sg-accent) / .035);
  }

  /* =========================================================
     Intro -- lead paragraph + "before you measure" checklist
     ========================================================= */
  .sg .sg__intro {
    max-inline-size: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  .sg .sg__intro > p {
    margin-block: 0 0;
    font-size: 1rem;
    line-height: 1.6;
    opacity: .75;
  }

  .sg .sg__intro > :is(h2, h3, h4) {
    margin-block: 2.25rem .9rem;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .5;
  }

  .sg .sg__intro > :is(ul, ol) {
    margin: 0;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--sg-line);
    border-radius: .8rem;
    background: var(--sg-tint);
    display: grid;
    gap: .8rem;
    list-style: none;
    text-align: start;
  }

  .sg .sg__intro > :is(ul, ol) > li {
    position: relative;
    margin: 0;
    padding-inline-start: 1.4rem;
    font-size: .9rem;
    line-height: 1.55;
    opacity: .8;
    list-style: none;
  }

  .sg .sg__intro > :is(ul, ol) > li::marker {
    content: "";
  }

  .sg .sg__intro > :is(ul, ol) > li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: .58em;
    inline-size: .42rem;
    block-size: .42rem;
    border-radius: 50%;
    background: var(--sg-gold);
  }

  @media (min-width: 800px) {
    .sg .sg__intro > :is(ul, ol) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.6rem;
      padding: 1.6rem 1.9rem;
    }
  }

  /* =========================================================
     Tab bar
     ========================================================= */
  .sg .sg__tablist {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: 0 !important;
    margin: 2.75rem 0 2.5rem !important;
    padding: 0 !important;
    list-style: none !important;
    border: 1px solid var(--sg-line);
    border-radius: .7rem;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .sg .sg__tablist {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .sg .sg__tablist::-webkit-scrollbar {
      display: none;
    }
    .sg .sg__tablist > li {
      flex: 0 0 6.5rem !important;
    }
  }

  .sg .sg__tablist > li {
    display: block !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    flex: 1 1 0 !important;
    min-width: 0;
  }

  .sg .sg__tablist > li + li {
    border-inline-start: 1px solid var(--sg-line);
  }

  .sg .sg__tablist > li::marker {
    content: "" !important;
  }

  .sg__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    width: 100%;
    height: 100%;
    min-height: 4.75rem;
    padding: .9rem .6rem;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: .65rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: .1em;
    text-align: center;
    text-transform: uppercase;
    color: rgb(var(--sg-accent) / .45);
    cursor: pointer;
    transition: color .18s, background .18s, box-shadow .18s;
  }

  .sg__tab svg {
    width: 23px;
    height: 23px;
    flex: none;
    opacity: .6;
    transition: opacity .18s, transform .18s, color .18s;
  }

  .sg__tab:hover {
    color: rgb(var(--sg-accent) / .8);
    background: rgb(var(--sg-accent) / .03);
  }

  .sg__tab[aria-selected='true'] {
    color: rgb(var(--sg-accent));
    background: var(--sg-tint);
    box-shadow: inset 0 -2px 0 var(--sg-gold);
  }

  .sg__tab[aria-selected='true'] svg {
    opacity: 1;
    color: var(--sg-gold);
    transform: scale(1.08);
  }

  /* =========================================================
     Panels
     ========================================================= */
  .sg__panel[hidden] {
    display: none;
  }

  .sg__panel {
    animation: sg-fade .25s ease;
  }

  @keyframes sg-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  .sg .sg__panel > h2 {
    margin: 0 0 1.6rem !important;
    padding-block-end: .9rem;
    border-block-end: 1px solid var(--sg-line);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    text-align: center;
  }

  .sg .sg__panel :is(h3, h4) {
    margin-block: 2.4rem .8rem;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .5;
  }

  .sg .sg__panel p {
    font-size: .95rem;
    line-height: 1.65;
  }

  /* =========================================================
     "How to measure" card -- identical shape for every category
     ========================================================= */
  .sg .sg__measure {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    margin: 0 0 .5rem;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--sg-line);
    border-radius: .9rem;
    background: var(--sg-tint);
  }

  @media (min-width: 760px) {
    .sg .sg__measure {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      padding: 2.4rem 2.6rem;
    }
  }

  .sg .sg__measure-steps {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    list-style: none;
  }

  .sg .sg__measure-steps > li {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .9rem;
    align-items: start;
    list-style: none;
  }

  .sg .sg__measure-steps > li::marker {
    content: "";
  }

  .sg .sg__measure-num {
    inline-size: 1.65rem;
    block-size: 1.65rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(var(--sg-accent) / .25);
    border-radius: 50%;
    color: var(--sg-gold);
    font-size: .72rem;
    font-weight: 600;
    line-height: 1;
  }

  .sg .sg__measure-steps p {
    margin: 0 !important;
    font-size: .92rem;
    line-height: 1.55;
    opacity: .85;
  }

  .sg .sg__measure-art {
    justify-self: center;
    inline-size: 100%;
  }

  .sg .sg__measure-art :is(svg, img) {
    display: block;
    inline-size: 100%;
    max-inline-size: {{ section.settings.illustration_width }}px;
    block-size: auto;
    margin-inline: auto;
    color: rgb(var(--sg-accent) / .8);
  }

  .sg .sg__measure-art .sg__diag-arrow {
    stroke: var(--sg-gold);
    stroke-width: 2.4;
  }

  /* =========================================================
     Size charts
     ========================================================= */
  .sg .sg__panel table {
    inline-size: 100%;
    border-collapse: collapse;
    margin-block: 1rem 1.4rem;
    font-size: .92rem;
  }

  .sg .sg__panel :is(th, td) {
    padding: .8rem 1rem;
    text-align: start;
    border-block-end: 1px solid var(--sg-line);
    white-space: nowrap;
  }

  .sg .sg__panel :is(thead th, tr:first-child th) {
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
    opacity: .5;
    border-block-end-color: rgb(var(--sg-accent) / .22);
  }

  .sg .sg__panel tbody tr:hover {
    background: rgb(var(--sg-accent) / .03);
  }

  .sg .sg__panel :is(td, tbody th):first-child {
    font-weight: 600;
  }

  .sg .sg__panel tbody tr:last-child :is(th, td) {
    border-block-end: 0;
  }

  @media (max-width: 700px) {
    .sg .sg__panel table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  /* trailing note / tip line at the end of a panel */
  .sg .sg__panel > p:last-child {
    margin-block-start: 1.4rem;
    padding: .95rem 1.15rem;
    border-inline-start: 2px solid var(--sg-gold);
    border-radius: 0 .45rem .45rem 0;
    background: var(--sg-tint);
    font-size: .88rem;
    opacity: .8;
  }
</style>

<div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container container--{{ section.settings.page_width }}">
    <div class="section-stack">
      {%- if section.settings.show_title -%}
        <div class="section-header justify-self-center text-center">
          <h1 class="h2">{{ page.title }}</h1>
        </div>
      {%- endif -%}

      {%- if page.content != empty -%}
        <content-tabs-split class="sg prose">
          {{ page.content }}
        </content-tabs-split>
      {%- else -%}
        <div class="prose">
          <p>Add this page's content in <strong>Admin &rsaquo; Content &rsaquo; Pages</strong>. Each <code>Heading 2</code> becomes a tab.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%}
  "How to measure" cards -- cloned into the matching tab by the script below.
  Same shape for every category: three steps on one side, an illustration on the
  other. A category's image_picker setting, when filled, replaces its SVG.
{%- endcomment -%}
<div hidden id="sg-diagrams-{{ section.id }}">
  <template data-key="ring">
    <div class="sg__measure">
      <ol class="sg__measure-steps">
        <li><span class="sg__measure-num" aria-hidden="true">1</span><p>Wrap a thin strip of paper around the base of your finger.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">2</span><p>Mark where it overlaps, then lay it flat against a ruler.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">3</span><p>Match that length in millimetres to the circumference column below.</p></li>
      </ol>
      <div class="sg__measure-art" aria-hidden="true">
        {%- if section.settings.img_ring != blank -%}
          {{- section.settings.img_ring | image_url: width: 900 | image_tag: widths: '300,450,600,900', loading: 'lazy', sizes: '(max-width: 759px) 80vw, 340px', alt: '' -}}
        {%- else -%}
          <svg viewBox="0 0 280 180" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" font-family="Archivo, system-ui, sans-serif">
            <rect x="20" y="112" width="240" height="46" rx="4"/>
            <path d="M60 112 V134 M110 112 V134 M160 112 V134 M210 112 V134"/>
            <path d="M40 112 v12 M80 112 v12 M95 112 v12 M130 112 v12 M145 112 v12 M180 112 v12 M195 112 v12 M230 112 v12 M245 112 v12"/>
            <g fill="currentColor" stroke="none" font-size="11" text-anchor="middle">
              <text x="60" y="152">1</text><text x="110" y="152">2</text><text x="160" y="152">3</text><text x="210" y="152">4</text>
            </g>
            <path d="M78 112 A56 56 0 0 1 190 112"/>
            <path d="M92 112 A42 42 0 0 1 176 112"/>
            <path d="M78 112 H92 M176 112 H190"/>
            <path class="sg__diag-arrow" d="M94 86 H174"/>
            <path class="sg__diag-arrow" d="M94 86 l10 -5 M94 86 l10 5 M174 86 l-10 -5 M174 86 l-10 5"/>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </template>

  <template data-key="wrist">
    <div class="sg__measure">
      <ol class="sg__measure-steps">
        <li><span class="sg__measure-num" aria-hidden="true">1</span><p>Wrap a tape measure around your wrist, just below the wrist bone.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">2</span><p>Keep it snug &mdash; you should still fit a fingertip underneath.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">3</span><p>Add 1&ndash;2&nbsp;cm for an easy fit, or more if you like it loose.</p></li>
      </ol>
      <div class="sg__measure-art" aria-hidden="true">
        {%- if section.settings.img_wrist != blank -%}
          {{- section.settings.img_wrist | image_url: width: 900 | image_tag: widths: '300,450,600,900', loading: 'lazy', sizes: '(max-width: 759px) 80vw, 340px', alt: '' -}}
        {%- else -%}
          <svg viewBox="0 0 280 160" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="140" cy="92" rx="72" ry="44"/>
            <path d="M68 92 a72 44 0 0 0 144 0" stroke-dasharray="4 6" opacity=".5"/>
            <path class="sg__diag-arrow" d="M68 40 H212"/>
            <path class="sg__diag-arrow" d="M68 40 l10 -5 M68 40 l10 5 M212 40 l-10 -5 M212 40 l-10 5"/>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </template>

  <template data-key="necklace">
    <div class="sg__measure">
      <ol class="sg__measure-steps">
        <li><span class="sg__measure-num" aria-hidden="true">1</span><p>Wrap a tape measure around your neck where you want the chain to sit.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">2</span><p>Check that length against the guide below to pick your size.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">3</span><p>Layering? Step each chain up by about 5&nbsp;cm so they sit clear of one another.</p></li>
      </ol>
      <div class="sg__measure-art" aria-hidden="true">
        {%- if section.settings.img_necklace != blank -%}
          {{- section.settings.img_necklace | image_url: width: 900 | image_tag: widths: '300,450,600,900', loading: 'lazy', sizes: '(max-width: 759px) 80vw, 340px', alt: '' -}}
        {%- else -%}
          <svg viewBox="0 0 320 210" fill="none" stroke="currentColor" stroke-width="2" font-family="Archivo, system-ui, sans-serif">
            <circle cx="160" cy="40" r="20"/>
            <path d="M120 58q40 26 80 0"/>
            <path d="M108 70q52 40 104 0" stroke-dasharray="2 4"/>
            <path d="M96 84q64 58 128 0" stroke-dasharray="2 4"/>
            <path d="M84 98q76 78 152 0" stroke-dasharray="2 4"/>
            <g fill="currentColor" stroke="none" font-size="10">
              <text x="238" y="62">40 cm</text>
              <text x="252" y="82">45 cm</text>
              <text x="266" y="104">50 cm</text>
              <text x="278" y="128">55 cm</text>
            </g>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </template>

  <template data-key="pendant">
    <div class="sg__measure">
      <ol class="sg__measure-steps">
        <li><span class="sg__measure-num" aria-hidden="true">1</span><p>The chain length decides where the bail rests on your chest.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">2</span><p>The pendant then hangs its own drop below that point.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">3</span><p>Add the two together to find where the piece finishes.</p></li>
      </ol>
      <div class="sg__measure-art" aria-hidden="true">
        {%- if section.settings.img_pendant != blank -%}
          {{- section.settings.img_pendant | image_url: width: 900 | image_tag: widths: '300,450,600,900', loading: 'lazy', sizes: '(max-width: 759px) 80vw, 340px', alt: '' -}}
        {%- else -%}
          <svg viewBox="0 0 320 200" fill="none" stroke="currentColor" stroke-width="2" font-family="Archivo, system-ui, sans-serif">
            <path d="M110 30q50 24 100 0"/>
            <path d="M160 30v70"/>
            <path d="M160 150c14 0 24-11 24-25s-24-32-24-32-24 18-24 32 10 25 24 25z"/>
            <path d="M210 30v70" stroke-dasharray="3 4"/>
            <path d="M210 100v50" stroke-dasharray="3 4"/>
            <g fill="currentColor" stroke="none" font-size="10">
              <text x="220" y="70">chain length</text>
              <text x="220" y="128">pendant drop</text>
            </g>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </template>

  <template data-key="earring">
    <div class="sg__measure">
      <ol class="sg__measure-steps">
        <li><span class="sg__measure-num" aria-hidden="true">1</span><p>Drop is measured from where the earring meets your ear to its lowest point.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">2</span><p>Studs sit flush; 2&ndash;3&nbsp;cm grazes the jawline.</p></li>
        <li><span class="sg__measure-num" aria-hidden="true">3</span><p>4&nbsp;cm and over reads as a statement drop.</p></li>
      </ol>
      <div class="sg__measure-art" aria-hidden="true">
        {%- if section.settings.img_earring != blank -%}
          {{- section.settings.img_earring | image_url: width: 900 | image_tag: widths: '300,450,600,900', loading: 'lazy', sizes: '(max-width: 759px) 80vw, 340px', alt: '' -}}
        {%- else -%}
          <svg viewBox="0 0 320 190" fill="none" stroke="currentColor" stroke-width="2" font-family="Archivo, system-ui, sans-serif">
            <path d="M150 30c-26 0-42 20-42 44 0 20 12 30 12 46 0 12 10 20 22 20"/>
            <circle cx="150" cy="46" r="4" fill="currentColor" stroke="none"/>
            <path d="M150 46 H250"/>
            <path d="M150 86 H250" stroke-dasharray="2 4"/>
            <path d="M150 126 H250" stroke-dasharray="2 4"/>
            <path d="M150 160 H250" stroke-dasharray="2 4"/>
            <g fill="currentColor" stroke="none" font-size="10">
              <text x="256" y="50">0 &middot; stud</text>
              <text x="256" y="90">2&ndash;3 cm</text>
              <text x="256" y="130">4&ndash;5 cm</text>
              <text x="256" y="164">6 cm +</text>
            </g>
          </svg>
        {%- endif -%}
      </div>
    </div>
  </template>
</div>

<script>
  (function () {
    if (customElements.get('content-tabs-split')) return;

    var ICONS = {
      ring: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="14" r="7"/><path d="M9 5.5 12 8l3-2.5L13.5 3h-3z"/></svg>',
      wrist: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="12" rx="8" ry="5.5"/><path d="M4 12a8 5.5 0 0 0 16 0" stroke-dasharray="1.5 2.5"/></svg>',
      necklace: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4c0 8 3.5 13 8 13s8-5 8-13"/><circle cx="12" cy="18.5" r="2"/></svg>',
      pendant: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 5c3 3 6 4.5 8 4.5S17 8 20 5"/><path d="M12 9.5V13"/><path d="M12 21c2.2 0 4-1.8 4-4s-4-4-4-4-4 1.8-4 4 1.8 4 4 4z"/></svg>',
      earring: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 4a3 3 0 0 1 6 0c0 2-3 2.5-3 5"/><circle cx="12" cy="15" r="5"/></svg>',
      ruler: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="8" width="20" height="8" rx="1"/><path d="M7 8v3M12 8v4M17 8v3"/></svg>'
    };

    var diagRoot = document.getElementById('sg-diagrams-{{ section.id }}');

    function keyFor(text) {
      var t = (text || '').toLowerCase();
      if (t.indexOf('ring') > -1 && t.indexOf('earring') === -1) return 'ring';
      if (t.indexOf('bracelet') > -1 || t.indexOf('bangle') > -1) return 'wrist';
      if (t.indexOf('pendant') > -1) return 'pendant';
      if (t.indexOf('necklace') > -1 || t.indexOf('chain') > -1) return 'necklace';
      if (t.indexOf('earring') > -1 || t.indexOf('hoop') > -1) return 'earring';
      return null;
    }

    var uid = 0;

    customElements.define('content-tabs-split', class extends HTMLElement {
      connectedCallback() {
        if (this._done) return;
        var heads = Array.prototype.filter.call(this.children, function (el) { return el.tagName === 'H2'; });
        if (heads.length < 2) return;
        this._done = true;
        uid += 1;

        var nodes = Array.prototype.slice.call(this.childNodes);
        var intro = document.createElement('div');
        intro.className = 'sg__intro';
        var panels = [];
        var current = null;

        nodes.forEach(function (node) {
          if (node.nodeType === 1 && node.tagName === 'H2') {
            // a trailing heading that isn't a jewellery category (e.g. "Still not sure?")
            // folds into the previous tab instead of getting its own
            if (panels.length && !keyFor(node.textContent)) {
              current = panels[panels.length - 1].el;
              current.appendChild(node);
              return;
            }
            current = document.createElement('div');
            current.className = 'sg__panel';
            current.setAttribute('role', 'tabpanel');
            current.appendChild(node);
            panels.push({ el: current, title: node.textContent.trim() });
          } else if (current) {
            current.appendChild(node);
          } else {
            intro.appendChild(node);
          }
        });

        // drop leftover "[ add image ... ]" placeholder lines from the pasted copy
        [intro].concat(panels.map(function (p) { return p.el; })).forEach(function (container) {
          Array.prototype.slice.call(container.querySelectorAll('p, div, figure')).forEach(function (el) {
            if (/\[\s*(add|insert)\b[^\]]*image[^\]]*\]/i.test(el.textContent || '')) el.remove();
          });
        });

        this.textContent = '';
        if (intro.childNodes.length) this.appendChild(intro);

        var tablist = document.createElement('ul');
        tablist.className = 'sg__tablist';
        tablist.setAttribute('role', 'tablist');

        panels.forEach(function (p, i) {
          var id = 'sg-' + uid + '-' + i;
          var key = keyFor(p.title);

          var li = document.createElement('li');
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'sg__tab';
          btn.id = id + '-tab';
          btn.setAttribute('role', 'tab');
          btn.setAttribute('aria-controls', id);
          btn.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
          btn.innerHTML = (ICONS[key] || ICONS.ruler) + '<span>' + p.title + '</span>';
          li.appendChild(btn);
          tablist.appendChild(li);

          p.el.id = id;
          p.el.setAttribute('aria-labelledby', id + '-tab');
          p.el.hidden = i !== 0;

          var tpl = key && diagRoot ? diagRoot.querySelector('template[data-key="' + key + '"]') : null;
          if (tpl) {
            p.el.insertBefore(tpl.content.cloneNode(true), p.el.children[1] || null);
          }

          btn.addEventListener('click', function () { select(i); });
          btn.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') { e.preventDefault(); select((i + 1) % panels.length, true); }
            if (e.key === 'ArrowLeft') { e.preventDefault(); select((i - 1 + panels.length) % panels.length, true); }
          });
        });

        this.appendChild(tablist);
        panels.forEach(function (p) { this.appendChild(p.el); }, this);

        var self = this;
        function select(idx, focus) {
          panels.forEach(function (p, i) {
            p.el.hidden = i !== idx;
            var tab = self.querySelector('#' + p.el.id + '-tab');
            tab.setAttribute('aria-selected', i === idx ? 'true' : 'false');
            if (i === idx && focus) tab.focus();
          });
        }
      }
    });
  })();
</script>
