{%- comment -%}
  Size guide page.

  Renders the page's own content (edited in Admin -> Content -> Pages) and, where
  JavaScript is available, turns each <h2> into a switchable tab. Into each tab it
  injects a "how to measure" card -- three short steps plus an illustration -- so
  every category reads the same way. With no JS it degrades to a stacked article.

  The illustrations are inline SVG by default; each category also has an image
  picker in the theme editor that replaces its SVG with your own artwork.

  It also forces the header to a solid white background -- but only on whatever
  template uses this section, because the section's <style> only loads there.
{%- endcomment -%}

<style>
  /* ---- Solid white header, this template only ---- */
  .header,
  .header__utility {
    --background: 255 255 255 / 1 !important;
    --background-gradient: 0 0 0 / 0 !important;
    --text-color: 28 28 28 !important;
    --header-transparent-header-text-color: 28 28 28 !important;
    --header-overlay: 255 255 255 / 1 !important;
    --header-show-transparent-logo: 0 !important;
    --header-separation-border-color: 0 0 0 / 0.10 !important;
  }

  #shopify-section-{{ section.id }} {
    --sg-accent: {{ section.settings.color_scheme.settings.text_color.rgb }};
    --sg-surface: {{ section.settings.color_scheme.settings.background.rgb }};
    --sg-gold: {{ section.settings.accent_color }};
    --sg-line: rgb(var(--sg-accent) / .12);
    --sg-tint: rgb(var(--sg-accent) / .035);
  }

  /* =========================================================
     Intro -- lead paragraph + "before you measure" checklist
     ========================================================= */
  .sg .sg__intro {
    max-inline-size: 52rem;
    margin-inline: auto;
    text-align: center;
  }

  .sg .sg__intro > p {
    margin-block: 0 0;
    font-size: 1rem;
    line-height: 1.6;
    opacity: .75;
  }

  .sg .sg__intro > :is(h2, h3, h4) {
    margin-block: 2.25rem .9rem;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .5;
  }

  .sg .sg__intro > :is(ul, ol) {
    margin: 0;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--sg-line);
    border-radius: .8rem;
    background: var(--sg-tint);
    display: grid;
    gap: .8rem;
    list-style: none;
    text-align: start;
  }

  .sg .sg__intro > :is(ul, ol) > li {
    position: relative;
    margin: 0;
    padding-inline-start: 1.4rem;
    font-size: .9rem;
    line-height: 1.55;
    opacity: .8;
    list-style: none;
  }

  .sg .sg__intro > :is(ul, ol) > li::marker {
    content: "";
  }

  .sg .sg__intro > :is(ul, ol) > li::before {
    content: "";
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: .58em;
    inline-size: .42rem;
    block-size: .42rem;
    border-radius: 50%;
    background: var(--sg-gold);
  }

  @media (min-width: 800px) {
    .sg .sg__intro > :is(ul, ol) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.6rem;
      padding: 1.6rem 1.9rem;
    }
  }

  /* =========================================================
     Tab bar
     ========================================================= */
  .sg .sg__tablist {
    display: flex !important;
    flex-wrap: nowrap !important;
    gap: 0 !important;
    margin: 2.75rem 0 2.5rem !important;
    padding: 0 !important;
    list-style: none !important;
    border: 1px solid var(--sg-line);
    border-radius: .7rem;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .sg .sg__tablist {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .sg .sg__tablist::-webkit-scrollbar {
      display: none;
    }
    .sg .sg__tablist > li {
      flex: 0 0 6.5rem !important;
    }
  }

  .sg .sg__tablist > li {
    display: block !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    flex: 1 1 0 !important;
    min-width: 0;
  }

  .sg .sg__tablist > li + li {
    border-inline-start: 1px solid var(--sg-line);
  }

  .sg .sg__tablist > li::marker {
    content: "" !important;
  }

  .sg__tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .55rem;
    width: 100%;
    height: 100%;
    min-height: 4.75rem;
    padding: .9rem .6rem;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: .65rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: .1em;
    text-align: center;
    text-transform: uppercase;
    color: rgb(var(--sg-accent) / .45);
    cursor: pointer;
    transition: color .18s, background .18s, box-shadow .18s;
  }

  .sg__tab svg {
    width: 23px;
    height: 23px;
    flex: none;
    opacity: .6;
    transition: opacity .18s, transform .18s, color .18s;
  }

  .sg__tab:hover {
    color: rgb(var(--sg-accent) / .8);
    background: rgb(var(--sg-accent) / .03);
  }

  .sg__tab[aria-selected='true'] {
    color: rgb(var(--sg-accent));
    background: var(--sg-tint);
    box-shadow: inset 0 -2px 0 var(--sg-gold);
  }

  .sg__tab[aria-selected='true'] svg {
    opacity: 1;
    color: var(--sg-gold);
    transform: scale(1.08);
  }

  /* =========================================================
     Panels
     ========================================================= */
  .sg__panel[hidden] {
    display: none;
  }

  .sg__panel {
    animation: sg-fade .25s ease;
  }

  @keyframes sg-fade {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: none; }
  }

  .sg .sg__panel > h2 {
    margin: 0 0 1.6rem !important;
    padding-block-end: .9rem;
    border-block-end: 1px solid var(--sg-line);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    text-align: center;
  }

  .sg .sg__panel :is(h3, h4) {
    margin-block: 2.4rem .8rem;
    font-size: .7rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    opacity: .5;
  }

  .sg .sg__panel p {
    font-size: .95rem;
    line-height: 1.65;
  }

  /* =========================================================
     "How to measure" card -- identical shape for every category
     ========================================================= */
  .sg .sg__measure {
    display: grid;
    gap: 1.75rem;
    align-items: center;
    margin: 0 0 .5rem;
    padding: 1.75rem 1.5rem;
    border: 1px solid var(--sg-line);
    border-radius: .9rem;
    background: var(--sg-tint);
  }

  @media (min-width: 760px) {
    .sg .sg__measure {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      padding: 2.4rem 2.6rem;
    }
  }

  .sg .sg__measure-steps {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.15rem;
    list-style: none;
  }

  .sg .sg__measure-steps > li {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: .9rem;
    align-items: start;
    list-style: none;
  }

  .sg .sg__measure-steps > li::marker {
    content: "";
  }

  .sg .sg__measure-num {
    inline-size: 1.65rem;
    block-size: 1.65rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(var(--sg-accent) / .25);
    border-radius: 50%;
    color: var(--sg-gold);
    font-size: .72rem;
    font-weight: 600;
    line-height: 1;
  }

  .sg .sg__measure-steps p {
    margin: 0 !important;
    font-size: .92rem;
    line-height: 1.55;
    opacity: .85;
  }

  .sg .sg__measure-art {
    justify-self: center;
    inline-size: 100%;
  }

  .sg .sg__measure-art :is(svg, img) {
    display: block;
    inline-size: 100%;
    max-inline-size: {{ section.settings.illustration_width }}px;
    block-size: auto;
    margin-inline: auto;
    color: rgb(var(--sg-accent) / .8);
  }

  .sg .sg__measure-art .sg__diag-arrow {
    stroke: var(--sg-gold);
    stroke-width: 2.4;
  }

  /* =========================================================
     Size charts
     ========================================================= */
  .sg .sg__panel table {
    inline-size: 100%;
    border-collapse: collapse;
    margin-block: 1rem 1.4rem;
    font-size: .92rem;
  }

  .sg .sg__panel :is(th, td) {
    padding: .8rem 1rem;
    text-align: start;
    border-block-end: 1px solid var(--sg-line);
    white-space: nowrap;
  }

  .sg .sg__panel :is(thead th, tr:first-child th) {
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .13em;
    text-transform: uppercase;
    opacity: .5;
    border-block-end-color: rgb(var(--sg-accent) / .22);
  }

  .sg .sg__panel tbody tr:hover {
    background: rgb(var(--sg-accent) / .03);
  }

  .sg .sg__panel :is(td, tbody th):first-child {
    font-weight: 600;
  }

  .sg .sg__panel tbody tr:last-child :is(th, td) {
    border-block-end: 0;
  }

  @media (max-width: 700px) {
    .sg .sg__panel table {
      display: block;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }

  /* trailing note / tip line at the end of a panel */
  .sg .sg__panel > p:last-child {
    margin-block-start: 1.4rem;
    padding: .95rem 1.15rem;
    border-inline-start: 2px solid var(--sg-gold);
    border-radius: 0 .45rem .45rem 0;
    background: var(--sg-tint);
    font-size: .88rem;
    opacity: .8;
  }

  /* =========================================================
     Necklace + bracelet tabs -- designed length guides
     (snippets/size-guide-necklace, size-guide-bracelet)
     ========================================================= */
  .sg .sg-lg {
    counter-reset: sg-lg-section;
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    max-inline-size: 58rem;
    margin-inline: auto;
  }

  .sg .sg-lg :is(p, li) {
    margin: 0 !important;
  }

  .sg .sg__panel .sg-lg p,
  .sg .sg-lg li {
    font-size: .95rem;
    line-height: 1.6;
  }

  .sg .sg-lg a:not(.button) {
    text-decoration: underline;
    text-decoration-color: var(--sg-gold);
    text-underline-offset: 3px;
  }

  .sg .sg-lg .sg-lg__rte > * + * {
    margin-block-start: .9rem !important;
  }

  .sg .sg__panel .sg-lg .sg-lg__small {
    font-size: .82rem;
    opacity: .7;
  }

  /* intro: lead copy + quick pick card */
  .sg .sg-lg__intro {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 760px) {
    .sg .sg-lg__intro {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .sg .sg__panel .sg-lg .sg-lg__lead p {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .sg .sg-lg__pick {
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    background: rgb(var(--sg-accent));
    color: rgb(var(--sg-surface));
  }

  .sg .sg__panel .sg-lg .sg-lg__pick-label {
    margin-block-end: .4rem !important;
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--sg-gold);
  }

  .sg .sg__panel .sg-lg .sg-lg__pick-text {
    font-size: .92rem;
    line-height: 1.5;
  }

  /* numbered section heads */
  .sg .sg-lg__section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sg .sg-lg__head {
    display: flex;
    align-items: baseline;
    gap: .9rem;
    padding-block-end: .9rem;
    border-block-end: 1px solid var(--sg-line);
  }

  .sg .sg-lg__num::before {
    counter-increment: sg-lg-section;
    content: counter(sg-lg-section, decimal-leading-zero);
    font-size: .75rem;
    font-weight: 600;
    letter-spacing: .1em;
    color: var(--sg-gold);
  }

  .sg .sg__panel .sg-lg .sg-lg__title {
    margin: 0 !important;
    font-family: var(--heading-font-family);
    font-size: clamp(1.35rem, 2.6vw, 1.7rem);
    font-weight: var(--heading-font-weight, 400);
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: none;
    opacity: 1;
  }

  /* length explorer: chips + illustration + detail card */
  .sg .sg-lg__explorer {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sg .sg-lg__chips {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
  }

  .sg .sg-lg__chip {
    padding: .55rem 1.1rem;
    border: 1px solid rgb(var(--sg-accent) / .2);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: .88rem;
    font-weight: 500;
    cursor: pointer;
    transition: background .18s, color .18s, border-color .18s;
  }

  .sg .sg-lg__chip:hover {
    border-color: rgb(var(--sg-accent) / .6);
  }

  .sg .sg-lg__chip.is-active {
    border-color: rgb(var(--sg-accent));
    background: rgb(var(--sg-accent));
    color: rgb(var(--sg-surface));
  }

  .sg .sg-lg__stage {
    display: grid;
    gap: 1.25rem;
    align-items: stretch;
  }

  @media (min-width: 700px) {
    .sg .sg-lg__stage {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .sg .sg-lg__media {
    overflow: hidden;
    border-radius: 1rem;
  }

  .sg .sg-lg__media :is(img, svg) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    margin: 0 !important;
  }

  .sg .sg-lg__line {
    fill: none;
    stroke: #b08d57;
    stroke-width: 1.5;
    opacity: .3;
    transition: opacity .25s, stroke-width .25s;
  }

  .sg .sg-lg__line.is-active {
    stroke: var(--sg-gold);
    stroke-width: 3.5;
    opacity: 1;
  }

  .sg .sg-lg__details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 1rem;
    background: var(--sg-tint);
    border: 1px solid var(--sg-line);
  }

  .sg .sg-lg__detail {
    display: none;
    flex-direction: column;
    gap: .5rem;
    animation: sg-fade .25s ease;
  }

  .sg .sg-lg__detail.is-active {
    display: flex;
  }

  .sg .sg__panel .sg-lg .sg-lg__detail-size {
    font-family: var(--heading-font-family);
    font-size: clamp(2.6rem, 6vw, 3.4rem);
    line-height: 1;
    color: var(--sg-gold);
  }

  .sg .sg__panel .sg-lg .sg-lg__detail-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .6rem;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .sg .sg-lg__badge {
    padding: .2rem .6rem;
    border-radius: 999px;
    background: var(--sg-gold);
    color: #fff;
    font-size: .62rem;
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .sg .sg__panel .sg-lg .sg-lg__detail-text p {
    font-size: .92rem;
    opacity: .8;
  }

  .sg .sg-lg__aside {
    margin-block-start: auto;
    padding-block-start: 1rem;
    border-block-start: 1px dashed rgb(var(--sg-accent) / .25);
  }

  .sg .sg__panel .sg-lg .sg-lg__aside p {
    font-size: .85rem;
  }

  /* rich-text lists shown as numbered cards */
  .sg .sg-lg__cards ol {
    counter-reset: sg-lg-card;
    display: grid;
    gap: .9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .sg .sg-lg__cards ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sg .sg-lg__cards li {
    position: relative;
    padding: 1.25rem 1.25rem 1.25rem 3.4rem;
    border: 1px solid var(--sg-line);
    border-radius: .9rem;
    font-size: .9rem;
    list-style: none;
  }

  .sg .sg-lg__cards li::marker {
    content: "";
  }

  .sg .sg-lg__cards li::before {
    counter-increment: sg-lg-card;
    content: counter(sg-lg-card);
    position: absolute;
    inset-block-start: 1.2rem;
    inset-inline-start: 1.1rem;
    display: grid;
    place-items: center;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border-radius: 50%;
    background: var(--sg-tint);
    border: 1px solid rgb(var(--sg-accent) / .15);
    color: var(--sg-gold);
    font-size: .75rem;
    font-weight: 600;
  }

  .sg .sg-lg__cards li strong {
    display: block;
    margin-block-end: .2rem;
    font-weight: 600;
  }

  /* measure at home: copy beside ruler, then a step row */
  .sg .sg-lg__measure {
    display: grid;
    gap: 1.25rem;
    align-items: center;
  }

  @media (min-width: 760px) {
    .sg .sg-lg__measure {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 2rem;
    }
  }

  .sg .sg-lg__ruler {
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--sg-tint);
    border: 1px solid var(--sg-line);
  }

  .sg .sg-lg__ruler :is(img, svg) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    margin: 0 !important;
  }

  .sg .sg-lg__steps ol {
    counter-reset: sg-lg-step;
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .sg .sg-lg__steps ol {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    }
  }

  .sg .sg-lg__steps li {
    padding-block-start: .9rem;
    border-block-start: 2px solid var(--sg-gold);
    font-size: .88rem;
    list-style: none;
  }

  .sg .sg-lg__steps li::marker {
    content: "";
  }

  .sg .sg-lg__steps li::before {
    counter-increment: sg-lg-step;
    content: "Step " counter(sg-lg-step);
    display: block;
    margin-block-end: .35rem;
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--sg-gold);
  }

  .sg .sg-lg__note {
    padding: .75rem 1rem;
    border-radius: .6rem;
    background: var(--sg-tint);
  }

  /* bracelet: wrist -> bracelet converter + fit chips */
  .sg .sg-lg__convert {
    overflow: hidden;
    border: 1px solid var(--sg-line);
    border-radius: 1rem;
  }

  .sg .sg-lg__convert-head,
  .sg .sg-lg__convert-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: .85rem 1.25rem;
  }

  .sg .sg-lg__convert-head {
    grid-template-columns: 1fr 1fr;
    background: var(--sg-tint);
    font-size: .65rem;
    font-weight: 600;
    letter-spacing: .14em;
    text-transform: uppercase;
    opacity: .75;
  }

  .sg .sg-lg__convert-head span:last-child,
  .sg .sg-lg__convert-row strong {
    text-align: end;
  }

  .sg .sg-lg__convert-row {
    border-block-start: 1px solid var(--sg-line);
    font-size: .92rem;
  }

  .sg .sg-lg__convert-row svg {
    inline-size: 1.1rem;
    color: var(--sg-gold);
  }

  .sg .sg-lg__convert-row strong {
    font-weight: 600;
  }

  .sg .sg-lg__fits ul {
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sg .sg-lg .sg-lg__fits li {
    padding: .45rem .9rem;
    border-radius: 999px;
    background: var(--sg-tint);
    border: 1px solid var(--sg-line);
    font-size: .82rem;
    list-style: none;
  }

  .sg .sg-lg__fits li::marker {
    content: "";
  }

  /* size chart + "find my size" (rings) */
  .sg .sg-lg__chart {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sg .sg-lg__finder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .75rem 1rem;
    padding: 1rem 1.25rem;
    border-radius: 1rem;
    background: rgb(var(--sg-accent));
    color: rgb(var(--sg-surface));
    font-size: .9rem;
  }

  .sg .sg-lg__finder-field {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .35rem .8rem;
    border-radius: 999px;
    background: rgb(var(--sg-surface));
    color: rgb(var(--sg-accent));
  }

  .sg .sg-lg__finder-field:focus-within {
    box-shadow: 0 0 0 2px var(--sg-gold);
  }

  .sg .sg-lg__finder-field input {
    inline-size: 4.5rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-weight: 600;
    outline: none;
    -moz-appearance: textfield;
  }

  .sg .sg-lg__finder-result {
    font-weight: 600;
    color: var(--sg-gold);
  }

  .sg .sg-lg__table-wrap {
    overflow-x: auto;
    border: 1px solid var(--sg-line);
    border-radius: 1rem;
  }

  .sg .sg__panel .sg-lg__table {
    display: table;
    margin: 0 !important;
    font-size: .9rem;
  }

  .sg .sg__panel .sg-lg__table :is(th, td) {
    padding: .7rem 1rem;
    text-align: center;
    font-weight: 400;
  }

  .sg .sg__panel .sg-lg__table thead th {
    background: var(--sg-tint);
    font-size: .65rem;
    font-weight: 600;
    opacity: .75;
  }

  .sg .sg__panel .sg-lg__table :is(td, tbody th):first-child {
    font-weight: 600;
  }

  .sg .sg__panel .sg-lg__table tbody tr.is-match {
    background: rgb(var(--sg-accent));
    color: rgb(var(--sg-surface));
  }

  /* FAQs: heading column beside the accordions */
  @media (min-width: 860px) {
    .sg .sg-lg__faq {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 2.5rem;
      align-items: start;
    }

    .sg .sg-lg__faq .sg-lg__head {
      position: sticky;
      inset-block-start: 6rem;
    }
  }

  .sg .sg-lg__faq-list .accordion {
    margin: 0 !important;
    border-block-end: 1px solid var(--sg-line);
  }

  .sg .sg-lg__faq-list .accordion__toggle {
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  /* bracelet videos + bangle feature */
  .sg .sg-lg__videos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: .75rem;
  }

  .sg .sg-lg__video video {
    display: block;
    inline-size: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: .9rem;
    margin: 0 !important;
  }

  .sg .sg-lg__feature {
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--sg-tint);
    border: 1px solid var(--sg-line);
  }

  @media (min-width: 700px) {
    .sg .sg-lg__feature {
      padding: 2.25rem;
    }

    .sg .sg-lg__feature--media {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 2.5rem;
    }
  }

  .sg .sg-lg__feature-media img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: .9rem;
    margin: 0 !important;
  }

  .sg .sg-lg__feature-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .sg .sg-lg__feature-copy > * {
    margin: 0 !important;
  }

  .sg .sg-lg__feature-copy ol {
    margin: 0;
    padding-inline-start: 1.2rem;
  }

  /* closing trust note */
  .sg .sg-lg__trust {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.25rem 1.4rem;
    border-radius: 1rem;
    border: 1px dashed rgb(var(--sg-accent) / .25);
  }

  .sg .sg-lg__trust-icon {
    flex: none;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    color: var(--sg-gold);
  }

  .sg .sg__panel .sg-lg .sg-lg__trust-title {
    margin-block-end: .2rem !important;
    font-size: .9rem;
    font-weight: 600;
  }

  .sg .sg__panel .sg-lg .sg-lg__trust-text p {
    font-size: .85rem;
    opacity: .75;
  }
</style>

<div class="section-spacing section-spacing--tight color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container container--{{ section.settings.page_width }}">
    <div class="section-stack">
      {%- if section.settings.show_title -%}
        <div class="section-header justify-self-center text-center">
          <h1 class="h2">{{ page.title }}</h1>
        </div>
      {%- endif -%}

      {%- if page.content != empty -%}
        <content-tabs-split class="sg prose">
