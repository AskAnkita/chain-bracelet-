{%- doc -%}
  This component is used to render the quick buy content. This snippet must always be included inside a product template (you can find an example in the "main-product.liquid" section). The reason is that we want to re-use the settings of the merchant on their product page. To do that, we need to re-use the whole product page, and extract the quick-buy part (rendered here).

  @param {object} product - the product to render
  @param {object} [section] - the section is implicitly available. Here, the section is always a "product" template section
{%- enddoc -%}

{%- capture product_form_id -%}product-form-quick-buy-{{ product.id }}-{{ section.id }}{%- endcapture -%}

<template id="quick-buy-content">
  {%- comment -%}The product page's option picker styles (metal photos, karat and length buttons), which live in that page's section and so don't reach this popup.{%- endcomment -%}
  <style>
    {%- render 'product-option-styles', scope: '.quick-buy-modal__content' -%}

    /* Photo pinned to the top beside the details, rather than centred against them with a gap above. */
    @media screen and (min-width: 700px) {
      .quick-buy-modal__content {
        align-items: start;
      }

      /*
        The gallery's arrows only show on phones; here they also show on desktop, as round
        buttons over the photo's left and right edges, beside the dots.
      */
      .quick-buy-modal__content .product-gallery__carousel-with-arrows {
        position: relative;
      }

      .quick-buy-modal__content :is(carousel-prev-button, carousel-next-button) > button {
        position: absolute;
        inset-block-start: 50%;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 999px;
        background: rgb(var(--background));
        box-shadow: 0 .125rem .625rem rgb(var(--text-color) / .15);
        transform: translateY(-50%);
        transition: opacity .2s ease;
      }

      .quick-buy-modal__content carousel-prev-button > button {
        inset-inline-start: .75rem;
      }

      .quick-buy-modal__content carousel-next-button > button {
        inset-inline-end: .75rem;
      }

      .quick-buy-modal__content :is(carousel-prev-button, carousel-next-button) > button svg {
        width: .75rem;
      }

      .quick-buy-modal__content :is(carousel-prev-button, carousel-next-button) > button[disabled] {
        opacity: 0;
        pointer-events: none;
      }
    }
  </style>

  <p class="h5" slot="header">{{ 'product.general.choose_options' | t }}</p>

  <div class="quick-buy-modal__content">
    <product-rerender id="quick-buy-modal-content" observe-form="{{ product_form_id }}">
      <dialog-close-button class="contents">
        <button type="button" class="quick-buy-modal__close-button sm-max:hidden">
          <span class="sr-only">{{ 'general.accessibility.close' | t }}</span>
          {%- render 'icon' with 'close' -%}
        </button>
      </dialog-close-button>

      <div class="quick-buy-modal__gallery-wrapper">
        {%- if product.media.size > 0 -%}
          {%- render 'product-gallery',
            product: product,
            product_form_id: product_form_id,
            desktop_layout: 'carousel_dots',
            mobile_controls: 'arrows',
            enable_media_autoplay: section.settings.enable_media_autoplay,
            enable_video_looping: section.settings.enable_video_looping,
            enable_image_zoom: false
          -%}
        {%- endif -%}

        <div class="quick-buy-modal__mobile-info v-stack gap-1 justify-center text-center sm:hidden">
          <a href="{{ product.url }}" class="product-title h6">{{ product.title }}</a>

          {%- if product.selected_or_first_available_variant != null -%}
            {% render 'price-list', product: product, variant: product.selected_or_first_available_variant, hide_unit_price: true, context: 'card' %}
          {%- endif -%}
        </div>
      </div>

      <div class="quick-buy-modal__info-wrapper">
        {%- render 'product-info', product: product, product_form_id: product_form_id, context: 'quick_buy' -%}
        <a href="{{ product.url }}" class="quick-buy-modal__view-more link sm-max:hidden">{{ 'product.general.view_details' | t }}</a>
      </div>
    </product-rerender>
  </div>
</template>
