{%- doc -%}
  Styles for the product's option pickers: the metal photos, karat and length buttons,
  and the spacing around them. Shared by the product page (main-product.liquid) and the
  quick view that opens from a product card's plus icon (product-quick-buy.liquid), which
  shows the same picker in a popup outside the product page's section, so it can't use
  that section's styles.

  @param {string} scope - selector the rules are limited to
{%- enddoc -%}

{%- comment -%}
  Variant picker internals: pull the option rows together, tighten the gap
  between swatches, and trim the block-swatch padding + min-width so the metal
  options pack into two or three rows instead of four.
{%- endcomment -%}
{{ scope }} .variant-picker {
  gap: 1rem;
}

{{ scope }} .variant-picker__option {
  gap: 0.65rem;
}

{%- comment -%}Match the material heading to the product accordion headings.{%- endcomment -%}
{{ scope }} .variant-picker__option-info legend {
  font-family: var(--heading-font-family);
  font-size: var(--text-h6);
  font-weight: var(--heading-font-weight);
  font-style: var(--heading-font-style);
  line-height: 1.7;
  letter-spacing: var(--heading-letter-spacing);
  text-transform: var(--heading-text-transform);
}

{{ scope }} .variant-picker__option-values {
  gap: 0.375rem;
}

{{ scope }} .block-swatch {
  --swatch-padding: 0.5rem 0.75rem;
  min-width: 0;
}

{%- comment -%}Length buttons match the boxed karat controls while staying compact.{%- endcomment -%}
{{ scope }} .variant-picker__option--length {
  gap: 0.35rem;
  margin-block-start: 0.2rem;
}

{{ scope }} .variant-picker__option--length .variant-picker__option-values {
  gap: 0.5rem;
  align-items: center;
}

{{ scope }} .variant-picker__option--length .block-swatch {
  min-width: 4rem;
  min-height: 2.75rem;
  padding: 0.55rem 0.75rem;
  border: 1px solid rgb(var(--text-color) / 0.2);
  border-radius: 0.25rem;
  color: rgb(var(--text-color) / 0.68);
  background: transparent;
  transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
}

@media screen and (pointer: fine) {
  {{ scope }} .variant-picker__option--length .block-swatch:hover {
    color: rgb(var(--text-color));
    border-color: rgb(173 125 49);
  }
}

{{ scope }} .variant-picker__option--length :checked + .block-swatch,
{{ scope }} .variant-picker__option--length .block-swatch.is-selected {
  color: rgb(173 125 49);
  border-color: rgb(173 125 49);
  background: rgb(173 125 49 / 0.08);
  box-shadow: inset 0 0 0 1px rgb(173 125 49);
  font-weight: 600;
}

{{ scope }} .variant-picker__option--length :focus-visible + .block-swatch {
  outline: 2px solid rgb(173 125 49);
  outline-offset: 2px;
}

{%- comment -%}
  The metal option (option-value.liquid `coin` type, variant-picker.liquid): a row of small
  product photos, one per metal -- Silver, Yellow Gold, White Gold, Rose Gold -- with the
  chosen one outlined in gold; under it, plain karat buttons (10K / 14K / 18K) for that
  metal only. Sterling silver comes in one karat, so it has no karat row.
{%- endcomment -%}
{{ scope }} .metal-variant-filter {
  display: block;
  width: 100%;
}

{{ scope }} .metal-variant-filter__tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 5rem));
  gap: 0.75rem;
}

{{ scope }} .metal-variant-filter__tab {
  display: grid;
  align-content: start;
  justify-items: center;
  gap: 0.45rem;
  min-width: 0;
  cursor: pointer;
}

{{ scope }} .metal-variant-filter__thumb {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 1;
  overflow: hidden;
  border: 1px solid rgb(var(--text-color) / 0.12);
  border-radius: 0.25rem;
  background: #f7f7f7;
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

{%- comment -%}The product photos have wide margins; zoomed in so the piece fills the tile.{%- endcomment -%}
{{ scope }} .metal-variant-filter__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.45);
  transform-origin: 50% 60%;
  transition: transform 0.3s ease;
}

{{ scope }} .metal-variant-filter__name {
  font-family: var(--heading-font-family);
  font-size: 0.6rem;
  letter-spacing: 0.06em;
  white-space: nowrap;
  line-height: 1.3;
  text-align: center;
  text-transform: uppercase;
  color: rgb(var(--text-color) / 0.8);
  transition: color 0.15s ease;
}

@media screen and (max-width: 699px) {
  {{ scope }} .metal-variant-filter__name {
    white-space: normal;
  }
}

@media screen and (pointer: fine) {
  {{ scope }} .metal-variant-filter__tab:hover .metal-variant-filter__thumb {
    border-color: rgb(173 125 49 / 0.5);
  }

  {{ scope }} .metal-variant-filter__tab:hover .metal-variant-filter__thumb img {
    transform: scale(1.55);
  }
}

{{ scope }} .metal-variant-filter__tab input:checked ~ .metal-variant-filter__thumb {
  border-color: rgb(173 125 49);
  box-shadow: inset 0 0 0 1px rgb(173 125 49);
}

{{ scope }} .metal-variant-filter__tab input:checked ~ .metal-variant-filter__name {
  color: rgb(173 125 49);
  font-weight: 600;
}

{{ scope }} .metal-variant-filter__tab input:focus-visible ~ .metal-variant-filter__thumb {
  outline: 2px solid rgb(173 125 49);
  outline-offset: 2px;
}

{%- comment -%}Karat buttons (the coin-swatch markup), shown for the chosen metal only.{%- endcomment -%}
{{ scope }} .variant-picker__option-values:has(.coin-swatch) {
  gap: 0.5rem;
  align-items: center;
  margin-block-start: 0.35rem;
}

{{ scope }} .coin-swatch {
  min-width: 3.5rem;
  padding: 0.55rem 0.9rem;
  border: 1px solid rgb(var(--text-color) / 0.2);
  border-radius: 0.25rem;
  background: transparent;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s ease, color 0.15s ease, background-color 0.15s ease;
}

{{ scope }} .coin-swatch__text {
  font-family: var(--heading-font-family);
  font-size: 0.72rem;
  letter-spacing: 0.1em;
  color: rgb(var(--text-color));
  pointer-events: none;
}

@media screen and (pointer: fine) {
  {{ scope }} .coin-swatch:hover {
    border-color: rgb(173 125 49);
  }
}

{{ scope }} :checked + .coin-swatch,
{{ scope }} .coin-swatch.is-selected {
  border-color: rgb(173 125 49);
  background: rgb(173 125 49 / 0.08);
  box-shadow: inset 0 0 0 1px rgb(173 125 49);
}

{{ scope }} :checked + .coin-swatch .coin-swatch__text,
{{ scope }} .coin-swatch.is-selected .coin-swatch__text {
  color: rgb(173 125 49);
  font-weight: 600;
}

{{ scope }} :focus-visible + .coin-swatch {
  outline: 2px solid rgb(173 125 49);
  outline-offset: 2px;
}

{{ scope }} .coin-swatch.is-disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

{{ scope }} .variant-picker__option--metal .coin-swatch[data-metal-group] {
  display: none;
}

{{ scope }} .variant-picker__option--metal[data-active-metal="yellow-gold"] .coin-swatch[data-metal-group="yellow-gold"],
{{ scope }} .variant-picker__option--metal[data-active-metal="white-gold"] .coin-swatch[data-metal-group="white-gold"],
{{ scope }} .variant-picker__option--metal[data-active-metal="rose-gold"] .coin-swatch[data-metal-group="rose-gold"] {
  display: flex;
}

{{ scope }} .variant-picker__option--metal[data-active-metal="silver"] .variant-picker__option-values {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  {{ scope }} .coin-swatch,
  {{ scope }} .metal-variant-filter__thumb,
  {{ scope }} .metal-variant-filter__thumb img {
    transition: none;
  }
}
