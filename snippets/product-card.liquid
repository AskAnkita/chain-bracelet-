{%- doc -%}
  This component is used in collection and featured collection to render a single product as a card.

  @param {object} [product] - the product to render
  @param {boolean} [stacked] - define if the product is stacked or not on mobile
  @param {boolean} [reveal] - if set to true, the card will be revealed on scroll through animation
  @param {number} [position] - the position of the card in the list. If specified, the theme will eagerly load the first 3 cards images
  @param {boolean} [show_badges] - show or not the badges (default to true if nothing is set)
  @param {boolean} [show_rating] - show or not the rating. If nothing is set, the theme uses the default product card setting
  @param {boolean} [show_vendor] - show or not the vendor. If nothing is set, the theme uses the default product card setting
  @param {boolean} [show_quick_buy] - show or not the quick buy (which opens a modal if the product contains more than 1 choice)
  @param {boolean} [show_secondary_image] - show or not the secondary media on hover. If nothing is set, the theme uses the default product card setting
  @param {boolean} [show_swatches] - show or not the swatches. The swatch type is inferred from setting, and will default to true if nothing is set
  @param {boolean} [hide_product_information] - if set to true, all content (vendor, badge, title...) are not rendered, to create image-based grid
  @param {boolean} [show_wishlist_button] - show or not the wishlist heart on the image (default to true)
  @param {string} [quick_buy_context] - a unique text to dissociate quick buy if the same product is embedded multiple times
  @param {object} [section]
  @param {object} [block]
{%- enddoc -%}

{%- liquid
  if hide_product_information
    assign show_badges = false
    assign show_rating = false
    assign show_vendor = false
    assign show_title = false
    assign show_prices = false
    assign show_swatches = false
    assign show_quick_buy = show_quick_buy | default: settings.show_quick_buy, allow_false: true
    assign show_secondary_image = show_secondary_image | default: settings.show_secondary_image, allow_false: true
  else
    assign show_badges = show_badges | default: true, allow_false: true
    assign show_rating = show_rating | default: settings.show_product_rating, allow_false: true
    assign show_vendor = show_vendor | default: settings.show_vendor, allow_false: true
    assign show_quick_buy = show_quick_buy | default: settings.show_quick_buy, allow_false: true
    assign show_title = true
    assign show_prices = true
    assign show_secondary_image = show_secondary_image | default: settings.show_secondary_image, allow_false: true
    assign show_swatches = show_swatches | default: true, allow_false: true
  endif

  # Cards show Silver by default. The featured photo is always the yellow-gold one, so
  # grids used to read as all gold:
  # - several metals: the card shows the 925 Sterling Silver variant (or, for products not
  #   sold in silver, white gold) and links to it, so the product page opens on what the
  #   card showed. Other metals are only a fallback for products sold in neither. The
  #   silver variant is picked whether or not it is in stock, so a sold-out silver still
  #   shows silver rather than jumping to gold;
  # - one metal: the card shows that metal.
  # Silver is photographed as white gold, the same way the silver variants use the
  # white-gold photo. Photos are picked by the metal label in their alt text ("#Jewelry
  # material_white_gold" and so on): the card shows the first photo of its metal and hovers
  # to the second. Some products link each variant to a later shot (the 4th), so this beats
  # the variant's own image, which is only the fallback for products without labels. A
  # "custom.card_image" or "custom.card_hover_image" metafield, when set, still wins and
  # turns this off for that product: those were picked to go with its default photo.
  assign card_variant = null
  assign card_media = null
  assign card_hover_media = null
  assign card_hover_from_labels = false
  assign card_metal = ''
  assign card_url = product.url

  if product.metafields.custom.card_image == blank and product.metafields.custom.card_hover_image == blank
    if product.variants.size > 1
      # In order of preference; "silver" and "white gold" both show the white-gold photos.
      assign preferred_metals = 'silver,white gold,yellow gold,rose gold' | split: ','

      for wanted_metal in preferred_metals
        for variant in product.variants
          assign variant_title = variant.title | downcase
          if variant_title contains wanted_metal
            assign card_variant = variant
            assign card_media = variant.featured_media
            assign card_url = variant.url
            assign card_metal = wanted_metal
            if wanted_metal == 'silver'
              assign card_metal = 'white gold'
            endif
            break
          endif
        endfor

        if card_variant != blank
          break
        endif
      endfor
    else
      assign only_title = product.variants.first.title | downcase
      if only_title contains 'silver' or only_title contains 'white gold'
        assign card_metal = 'white gold'
      elsif only_title contains 'rose gold'
        assign card_metal = 'rose gold'
      elsif only_title contains 'yellow gold'
        assign card_metal = 'yellow gold'
      endif
    endif

    if card_metal != ''
      # Alt labels read "#Jewelry material_Gold" for yellow, "..._white_gold", "..._Rose gold".
      assign alt_label = card_metal
      if card_metal == 'yellow gold'
        assign alt_label = 'material gold'
      endif

      assign label_first = null
      assign label_second = null

      for media in product.media
        assign media_alt = media.alt | downcase | replace: '_', ' '
        if media.media_type == 'image' and media_alt contains alt_label
          if label_first == blank
            assign label_first = media
          else
            assign label_second = media
            break
          endif
        endif
      endfor

      if label_first != blank
        assign card_media = label_first
        assign card_hover_media = label_second
        assign card_hover_from_labels = true
      endif
    endif
  endif
-%}

<product-card
  class="product-card"
  {% if reveal %}
    reveal-on-scroll="true"
  {% endif %}
  handle="{{ product.handle | escape }}"
>
  {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    PRODUCT MEDIA
    --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

    <div class="product-card__figure">
      {%- if show_badges -%}
        {%- render 'product-badges', product: product, vertical: true, context: 'card' -%}
      {%- endif -%}

      {%- comment -%}
        icon_width: 16 to match the quick-add "+" button's own icon size, so the two
        (separate, top-right/bottom-right) corner buttons stay the same size as each other.
      {%- endcomment -%}
      {%- unless hide_product_information or show_wishlist_button == false -%}
        {%- render 'wishlist-button', product: product, class: 'product-card__wishlist-button', icon_width: 16 -%}
      {%- endunless -%}

      <a href="{{ card_url }}" class="product-card__media" draggable="false" data-instant>
        {%- if product.media.size > 0 -%}
          {%- capture sizes -%}
            {%- assign products_per_row_desktop = section.settings.products_per_row_desktop | default: 3 -%}

            {%- if stacked -%}
              (max-width: 699px) calc(100vw / {{ section.settings.products_per_row_mobile | default: 2 }}), (max-width: 999px) calc(100vw / {{ 3 | at_most: products_per_row_desktop }} - 64px), calc((100vw - 96px) / {{ products_per_row_desktop }} - (24px / {{ products_per_row_desktop }} * {{ products_per_row_desktop | minus: 1 }}))
            {%- else -%}
              (max-width: 699px) 74vw, (max-width: 999px) 38vw, calc((100vw - 96px) / {{ products_per_row_desktop }} - (24px / {{ products_per_row_desktop }} * {{ products_per_row_desktop | minus: 1 }}))
            {%- endif -%}
          {%- endcapture -%}

          {%- liquid
            assign main_media_loading_strategy = null

            if section.index > 3 or position > 3
              assign main_media_loading_strategy = 'lazy'
            endif

            # If the "custom.card_image" metafield exists for this product we use this one, otherwise the metal picked
            # above, otherwise we default as the featured image
            assign featured_media = product.metafields.custom.card_image.value | default: card_media | default: product.featured_media
          -%}

          {%- capture main_image_classes -%}product-card__image product-card__image--primary {% if settings.product_image_aspect_ratio contains 'crop' %}object-cover{% endif %} aspect-{{ settings.product_image_aspect_ratio | split: '_' | first }}{%- endcapture -%}
          {{-
            featured_media
            | image_url: width: featured_media.width
            | image_tag:
              loading: main_media_loading_strategy,
              sizes: sizes,
              widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800',
              draggable: 'false',
              class: main_image_classes
          -}}

          {%- comment -%}
            Reuses main_image_classes (just swapping --primary for --secondary) so the
            hover/secondary image gets the exact same aspect-ratio + object-cover crop as the
            primary one -- without this it only had object-fit: contain and no forced ratio,
            so a non-square hover photo (a lifestyle/model shot, say) would fit inside its box
            with letterboxing on the sides instead of filling it the way the primary image does.
          {%- endcomment -%}
          {%- liquid
            if show_secondary_image and product.media.size > 1
              # With metal labels, hover to the same metal's second photo, or to nothing if it has only one (never to
              # another metal's photo). Without labels, fall back to the photo after the card's photo.
              if card_hover_from_labels
                assign next_media = product.metafields.custom.card_hover_image.value | default: card_hover_media
              else
                assign hover_after = card_media.position | default: product.featured_media.position
                assign next_media = product.metafields.custom.card_hover_image.value | default: product.media[hover_after] | default: product.media[1]
              endif

              if next_media != blank
                assign secondary_image_classes = main_image_classes | replace: '--primary', '--secondary'
                echo next_media | image_url: width: next_media.width | image_tag: class: secondary_image_classes, loading: 'lazy', fetchpriority: 'low', sizes: sizes, widths: '200,300,400,500,600,700,800,1000,1200,1400,1600,1800', draggable: 'false', aria-hidden: 'true'
              endif
            endif
          -%}
        {%- else -%}
          {%- comment -%} No image uploaded yet for this product: reuse the jewelry placeholder icon so the card isn't blank {%- endcomment -%}
          {%- render 'jewelry-placeholder-icon', index: position, class: 'product-card__image product-card__image--primary placeholder' -%}
        {%- endif -%}
      </a>

      {%- if show_quick_buy and product.available -%}
        {%- if product.variants.size == 1 and product.selling_plan_groups.size == 0 -%}
          <product-form>
            {%- form 'product', product -%}
              <input type="hidden" name="on_success" value="force_open_drawer">
              <input type="hidden" name="quantity" value="1">
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="product-card__quick-add-button">
                <span class="sr-only">{{ 'product.general.add_to_cart_button' | t }}</span>
                {%- render 'icon' with 'plus', width: 16 -%}
              </button>
            {%- endform -%}
          </product-form>
        {%- else -%}
          {%- capture quick_buy_id -%}product-quick-buy-{{ section.id }}-{{ block.id }}-{{ quick_buy_context }}-{{ product.id }}{%- endcapture -%}

          <button type="button" aria-controls="{{ quick_buy_id }}" class="product-card__quick-add-button">
            <span class="sr-only">{{ 'product.general.choose_options' | t }}</span>
            {%- render 'icon' with 'plus', width: 16 -%}
          </button>

          <quick-buy-modal
            handle="{{ product.handle }}?variant={{ card_variant.id | default: product.selected_or_first_available_variant.id }}"
            class="quick-buy-modal modal"
            id="{{ quick_buy_id }}"
            aria-label="{{ 'product.general.choose_options_with_title' | t: title: product.title | escape }}"
          >
          </quick-buy-modal>
        {%- endif -%}
      {%- endif -%}
    </div>

  {%- comment -%}
    --------------------------------------------------------------------------------------------------------------------
    PRODUCT INFO
    --------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div class="product-card__info empty:hidden">
    {%- assign text_class = '' -%}

    {%- if settings.product_card_text_font == 'heading' -%}
      {%- assign text_class = 'h6' -%}
    {%- endif -%}

    {%- if show_title or show_prices or show_vendor and product.vendor != blank -%}
      <div class="v-stack justify-items-center gap-2">
        {%- if show_vendor and product.vendor != blank -%}
          {%- capture vendor_class -%}smallcaps {% if settings.product_card_text_font == 'heading' %}heading{% endif %}{% endcapture %}
          {%- render 'vendor' with product.vendor, class: vendor_class -%}
        {%- endif -%}

        {%- if show_title or show_prices -%}
          <div class="v-stack justify-items-center gap-1">
            {%- if show_title -%}
              <a
                href="{{ card_url }}"
                class="product-title {% if text_class != blank %}{{ text_class }}{% endif %} {% if settings.product_title_max_lines > 0 %}line-clamp{% endif %}"
                {% if settings.product_title_max_lines > 0 %}
                  style="--line-clamp-count: {{ settings.product_title_max_lines }}"
                {% endif %}
                data-instant
              >
                {{- product.title -}}
              </a>
            {%- endif -%}

            {%- if show_prices -%}
              {%- render 'price-list', product: product, context: 'card' -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_swatches and settings.product_color_display != 'hide' -%}
      {%- liquid
        assign matched_product_option = null
        assign color_label_list = 'general.label.color' | t | replace: ', ', ',' | downcase | split: ','

        # First, we try to find an option named explicitly "color" in the store's language
        for color_label in color_label_list
          if product.options_by_name[color_label] != blank
            assign matched_product_option = product.options_by_name[color_label]
            break
          endif
        endfor

        # If we didn't find an option named "color", we try to find an option that has swatches, as this is probably
        # the color option that the merchant want to use for swatches
        if matched_product_option == blank
          for product_option in product.options_with_values
            assign values_with_swatch = product_option.values | where: 'swatch'

            if values_with_swatch.size > 0
              assign matched_product_option = product_option
              break
            endif
          endfor
        endif
      -%}

      {%- if matched_product_option != blank -%}
        {%- case settings.product_color_display -%}
          {%- when 'count' -%}
            <p class="smallcaps text-subdued">{{- 'product.general.available_colors_count' | t: count: matched_product_option.values.size -}}</p>

          {%- when 'swatch' -%}
            <fieldset class="h-stack wrap justify-center gap-1">
              <legend class="sr-only">{{ matched_product_option.name }}</legend>

              {%- capture param_name -%}swatch-{{ quick_buy_context }}-{{ section.id }}-{{ block.id }}-{{ product.id }}-{{ matched_product_option.position }}{%- endcapture -%}

              {%- liquid
                for option_value in matched_product_option.values
                  render 'option-value', type: 'swatch', option_value: option_value, param_name: param_name, option_position: matched_product_option.position, output_variant_media: true, size: 'sm'
                endfor
              -%}
            </fieldset>
        {%- endcase -%}
      {%- endif -%}
    {%- endif -%}

    {%- if show_rating -%}
      {%- render 'product-rating', product: product, show_empty: settings.show_product_rating_if_empty, display_mode: settings.product_rating_mode -%}
    {%- endif -%}
  </div>
</product-card>
