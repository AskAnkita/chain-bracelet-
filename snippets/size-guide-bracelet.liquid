{%- doc -%}
  Designed "Bracelets" tab for the size guide page (sections/size-guide-tabs.liquid).

  Rendered as a <template data-key="wrist" data-replace>: the section script clones it into
  the bracelet tab in place of the tab's own page content. Everything here is edited in the
  theme editor -- section settings plus "Bracelet length", "Bracelet FAQ" and "Bracelet video"
  blocks. Shares its layout styles (.sg-lg) with snippets/size-guide-necklace.liquid.

  @param {object} section - the size-guide-tabs section
{%- enddoc -%}

{%- liquid
  assign lengths = section.blocks | where: 'type', 'bracelet_length'
  assign faqs = section.blocks | where: 'type', 'bracelet_faq'
  assign videos = section.blocks | where: 'type', 'bracelet_video'

  assign active = 0
  for block in lengths
    if block.settings.popular
      assign active = forloop.index0
      break
    endif
  endfor
-%}

<template data-key="wrist" data-replace>
  <div class="sg-lg">
    {%- render 'size-guide-intro', text: section.settings.br_intro, tip_label: section.settings.br_tip_label, tip: section.settings.br_tip -%}

    {%- comment -%} 01 -- length explorer {%- endcomment -%}
    {%- if lengths.size > 0 -%}
      <div class="sg-lg__section">
        <div class="sg-lg__head">
          <span class="sg-lg__num" aria-hidden="true"></span>
          <h3 class="sg-lg__title">{{ section.settings.br_lengths_title }}</h3>
        </div>

        {%- render 'size-guide-explorer', section: section, blocks: lengths, active: active, image: section.settings.img_wrist, art: 'wrist', label: section.settings.br_lengths_title -%}
      </div>
    {%- endif -%}

    {%- comment -%} 02 -- how to choose {%- endcomment -%}
    {%- if section.settings.br_choose != blank -%}
      <div class="sg-lg__section">
        <div class="sg-lg__head">
          <span class="sg-lg__num" aria-hidden="true"></span>
          <h3 class="sg-lg__title">{{ section.settings.br_choose_title }}</h3>
        </div>
        <div class="sg-lg__rte sg-lg__cards">{{ section.settings.br_choose }}</div>
      </div>
    {%- endif -%}

    {%- comment -%} 03 -- measure at home + size converter {%- endcomment -%}
    <div class="sg-lg__section">
      <div class="sg-lg__head">
        <span class="sg-lg__num" aria-hidden="true"></span>
        <h3 class="sg-lg__title">{{ section.settings.br_measure_title }}</h3>
      </div>

      <div class="sg-lg__measure">
        <div class="sg-lg__rte">
          {{- section.settings.br_measure_text -}}
          {%- if section.settings.br_ruler_url != blank -%}
            <p class="sg-lg__small">{{ section.settings.br_ruler_prefix }} <a href="{{ section.settings.br_ruler_url }}" target="_blank" rel="noopener">{{ section.settings.br_ruler_link_text }}</a></p>
          {%- endif -%}
        </div>

        <div class="sg-lg__ruler">
          {%- if section.settings.br_ruler_image != blank -%}
            {{- section.settings.br_ruler_image | image_url: width: 1200 | image_tag: widths: '400,600,800,1200', loading: 'lazy', sizes: '(max-width: 699px) 92vw, 420px', alt: section.settings.br_ruler_image.alt -}}
          {%- else -%}
            <svg viewBox="0 0 480 150" role="img" aria-label="A bracelet laid flat beside a ruler" font-family="Archivo, system-ui, sans-serif">
              <g fill="none" stroke="#b08d57" stroke-width="2">
                <circle cx="34" cy="44" r="6"/>
                {%- for i in (0..34) -%}
                  {%- assign cx = i | times: 12 | plus: 46 -%}
                  <ellipse cx="{{ cx }}" cy="44" rx="6.5" ry="5"/>
                {%- endfor -%}
                <circle cx="460" cy="44" r="4"/>
              </g>
              <rect x="20" y="78" width="440" height="46" rx="4" fill="#fff" stroke="#d6d0c8"/>
              <g stroke="#9a9189" stroke-width="1">
                {%- for i in (0..52) -%}
                  {%- assign tx = i | times: 8 | plus: 30 -%}
                  {%- assign m = i | modulo: 8 -%}
                  {%- if m == 0 -%}
                    <line x1="{{ tx }}" y1="78" x2="{{ tx }}" y2="94"/>
                  {%- elsif m == 4 -%}
                    <line x1="{{ tx }}" y1="78" x2="{{ tx }}" y2="89"/>
                  {%- else -%}
                    <line x1="{{ tx }}" y1="78" x2="{{ tx }}" y2="84"/>
                  {%- endif -%}
                {%- endfor -%}
              </g>
              <g fill="#1c1c1c" font-size="10" text-anchor="middle">
                {%- for i in (1..6) -%}
                  {%- assign nx = i | times: 64 | plus: 30 -%}
                  <text x="{{ nx }}" y="112">{{ i }}</text>
                {%- endfor -%}
                <text x="446" y="112">6.5</text>
              </g>
            </svg>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.br_steps != blank -%}
        <div class="sg-lg__rte sg-lg__steps">{{ section.settings.br_steps }}</div>
      {%- endif -%}

      {%- if section.settings.br_note != blank -%}
        <p class="sg-lg__small sg-lg__note">{{ section.settings.br_note }}</p>
      {%- endif -%}

      {%- if section.settings.br_table != blank -%}
        {%- render 'size-guide-convert', rows: section.settings.br_table, col1: section.settings.br_table_col1, col2: section.settings.br_table_col2 -%}
      {%- endif -%}

      {%- if section.settings.br_fit_tips != blank -%}
        <div class="sg-lg__rte sg-lg__fits">{{ section.settings.br_fit_tips }}</div>
      {%- endif -%}
    </div>

    {%- comment -%} 04 -- FAQs {%- endcomment -%}
    {%- if faqs.size > 0 -%}
      <div class="sg-lg__section sg-lg__faq">
        <div class="sg-lg__head">
          <span class="sg-lg__num" aria-hidden="true"></span>
          <h3 class="sg-lg__title">{{ section.settings.br_faq_title }}</h3>
        </div>
        <div class="sg-lg__faq-list">
          {%- for block in faqs -%}
            {%- render 'accordion', title: block.settings.question, content: block.settings.answer, prose_content: true, block: block -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} How-to videos {%- endcomment -%}
    {%- if videos.size > 0 -%}
      <div class="sg-lg__videos">
        {%- for block in videos -%}
          {%- if block.settings.video != blank -%}
            <div class="sg-lg__video" {{ block.shopify_attributes }}>
              {{- block.settings.video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '600x' -}}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} Bangles {%- endcomment -%}
    {%- if section.settings.br_bangle_text != blank -%}
      <div class="sg-lg__feature {% if section.settings.br_bangle_image != blank %}sg-lg__feature--media{% endif %}">
        {%- if section.settings.br_bangle_image != blank -%}
          <div class="sg-lg__feature-media">
            {{- section.settings.br_bangle_image | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', loading: 'lazy', sizes: '(max-width: 699px) 92vw, 400px', alt: section.settings.br_bangle_image.alt -}}
          </div>
        {%- endif -%}

        <div class="sg-lg__feature-copy">
          {%- if section.settings.br_bangle_title != blank -%}
            <h3 class="sg-lg__title">{{ section.settings.br_bangle_title }}</h3>
          {%- endif -%}
          <div class="sg-lg__rte">{{ section.settings.br_bangle_text }}</div>
          {%- if section.settings.br_bangle_button_label != blank and section.settings.br_bangle_button_link != blank -%}
            <a class="button" href="{{ section.settings.br_bangle_button_link }}">{{ section.settings.br_bangle_button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.br_trust_text != blank -%}
      {%- render 'size-guide-trust', title: section.settings.br_trust_title, text: section.settings.br_trust_text -%}
    {%- endif -%}
  </div>
</template>
