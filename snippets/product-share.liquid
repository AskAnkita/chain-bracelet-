{%- doc -%}
  A share icon button for the product page, drawn like the square wishlist button next
  to "Add to cart". Clicking it opens a small menu: Email, Facebook, WhatsApp and Copy
  link. The menu closes on a second click, a click outside it, or Escape.

  @param {object} product
  @param {string} [id_suffix] - makes the menu's ID unique when the button appears twice (the quick-buy popup)
  @param {string} [class] - additional classes for the wrapping element
{%- enddoc -%}

{%- liquid
  assign share_url = request.origin | append: product.url
  assign share_text = product.title | append: ' ' | append: share_url

  # Encoded with %20 for spaces: mail apps show a "+" from url_encode as a literal plus.
  assign encoded_title = product.title | url_encode | replace: '+', '%20'
  assign encoded_text = share_text | url_encode | replace: '+', '%20'
  assign menu_id = 'ProductShareMenu-' | append: product.id | append: '-' | append: id_suffix
-%}

<product-share class="product-share {{ class }}" share-url="{{ share_url }}">
  <button type="button" class="product-share__toggle tap-area" aria-expanded="false" aria-controls="{{ menu_id }}" aria-label="{{ 'general.social.share' | t }}">
    <svg class="product-share__icon" aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 10.5 14 4v4.1C8.4 8.7 4.2 12 2 18.5c3.5-3.2 7.4-4.8 12-4.8V18l7-7.5Z"/>
    </svg>
  </button>

  <div id="{{ menu_id }}" class="product-share__menu" hidden>
    <ul class="product-share__options unstyled-list" role="list">
      <li>
        <a class="product-share__option" href="mailto:?subject={{ encoded_title }}&body={{ encoded_text }}">
          {%- render 'icon' with 'email', width: 18 -%}
          <span>Email</span>
        </a>
      </li>

      <li>
        <a class="product-share__option" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener">
          {%- render 'icon' with 'facebook', width: 18 -%}
          <span>Facebook</span>
        </a>
      </li>

      <li>
        <a class="product-share__option" href="https://wa.me/?text={{ encoded_text }}" target="_blank" rel="noopener">
          {%- render 'icon' with 'whatsapp', width: 18 -%}
          <span>WhatsApp</span>
        </a>
      </li>

      <li>
        <button type="button" class="product-share__option" data-share="copy">
          <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 13.5a4.5 4.5 0 0 0 6.4.4l3-3a4.5 4.5 0 0 0-6.4-6.4l-1.2 1.2"/>
            <path d="M14 10.5a4.5 4.5 0 0 0-6.4-.4l-3 3a4.5 4.5 0 0 0 6.4 6.4l1.2-1.2"/>
          </svg>
          <span class="product-share__copy-label" role="status" aria-live="polite">Copy link</span>
        </button>
      </li>
    </ul>
  </div>
</product-share>

<script>
  if (!window.customElements.get('product-share')) {
    window.customElements.define('product-share', class extends HTMLElement {
      connectedCallback() {
        this.toggle = this.querySelector('.product-share__toggle');
        this.menu = this.querySelector('.product-share__menu');
        this.onOutside = (event) => { if (!this.contains(event.target)) this.close(); };
        this.onKey = (event) => { if (event.key === 'Escape') { this.close(); this.toggle.focus(); } };

        this.toggle.addEventListener('click', () => (this.menu.hidden ? this.open() : this.close()));
        this.querySelector('[data-share="copy"]').addEventListener('click', (event) => this.copy(event.currentTarget));
        this.menu.addEventListener('click', (event) => { if (event.target.closest('a')) this.close(); });
      }

      disconnectedCallback() { this.close(); }

      open() {
        this.menu.hidden = false;
        this.toggle.setAttribute('aria-expanded', 'true');
        document.addEventListener('click', this.onOutside);
        document.addEventListener('keydown', this.onKey);
      }

      close() {
        if (!this.menu) return;
        this.menu.hidden = true;
        this.toggle.setAttribute('aria-expanded', 'false');
        document.removeEventListener('click', this.onOutside);
        document.removeEventListener('keydown', this.onKey);
      }

      async copy(button) {
        const url = this.getAttribute('share-url') || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
        } catch (error) {
          const field = Object.assign(document.createElement('textarea'), { value: url });
          field.style.cssText = 'position:fixed;opacity:0';
          document.body.append(field);
          field.select();
          document.execCommand('copy');
          field.remove();
        }

        const label = button.querySelector('.product-share__copy-label');
        label.textContent = 'Link copied';
        button.classList.add('is-done');
        clearTimeout(this.timer);
        this.timer = setTimeout(() => {
          label.textContent = 'Copy link';
          button.classList.remove('is-done');
        }, 2500);
      }
    });
  }
</script>
