{%- doc -%}
  Show the active facets for a given faceted search. This snippet automatically reads some global section settings to
  decide to show or not the filter group name

  @param {object} results - : either collection or search drop to extract the active facets from
  @param {object} [section]
{%- enddoc -%}

{%- assign active_values_count = 0 -%}

{%- capture active_facets -%}
  {%- for filter in results.filters -%}
    {%- if filter.type == 'price_range' -%}
      {%- if filter.max_value.value != blank or filter.min_value.value != blank -%}
        <div class="removable-facet">
          <facet-link>
            <a href="{{ filter.url_to_remove }}" class="tap-area link-faded" aria-label="{{ 'collection.faceting.remove_filter' | t: name: filter.label }}" data-no-instant>
              {%- render 'icon' with 'close', width: 10 -%}
            </a>
          </facet-link>

          {%- if section.settings.show_filter_group_name -%}
            <span class="text-subdued">{{- filter.label }}: {{ filter.min_value.value | default: 0 | money_without_trailing_zeros }} - {{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros -}}</span>
          {%- else -%}
            <span class="text-subdued">{{- filter.min_value.value | default: 0 | money_without_trailing_zeros }} - {{ filter.max_value.value | default: filter.range_max | money_without_trailing_zeros -}}</span>
          {%- endif -%}
        </div>

        {%- assign active_values_count = active_values_count | plus: 1 -%}
      {%- endif -%}
    {%- else -%}
      {%- comment -%}
        The tag filter is shown as a group per prefix (snippets/facet-tag-groups.liquid),
        so its chips read "Round", under the group "Shape", rather than "Shape:Round".
      {%- endcomment -%}
      {%- for active_value in filter.active_values -%}
        {%- liquid
          assign facet_group = filter.label
          assign facet_label = active_value.label

          if filter.param_name contains 'jewelry material' or filter.param_name contains 'jewellery material'
            assign facet_group = 'Jewelry Material'
          endif

          if filter.param_name == 'filter.p.tag'
            assign value_parts = active_value.value | split: ':'
            if value_parts.size > 1
              assign facet_group = value_parts[0]
              assign tag_prefix = facet_group | append: ':'
              assign facet_label = active_value.label | remove_first: tag_prefix | strip
            endif
          endif
        -%}

        <div class="removable-facet">
          <facet-link>
            <a href="{{ active_value.url_to_remove }}" class="tap-area link-faded" aria-label="{{ 'collection.faceting.remove_filter' | t: name: facet_label }}" data-no-instant>
              {%- render 'icon' with 'close', width: 10 -%}
            </a>
          </facet-link>

          {%- if section.settings.show_filter_group_name or filter.type == 'boolean' -%}
            <span class="text-subdued">{{- facet_group }}: {{ facet_label -}}</span>
          {%- else -%}
            <span class="text-subdued">{{- facet_label -}}</span>
          {%- endif -%}
        </div>

        {%- assign active_values_count = active_values_count | plus: 1 -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

  {%- comment -%}
    A Shape, Type or Style picked from the tag links (snippets/facet-tag-links.liquid) lives
    in the path (/collections/earrings/shape-round+type-studs), not among the filters.
  {%- endcomment -%}
  {%- if request.page_type == 'collection' -%}
    {%- liquid
      assign current_list = ''
      for tag in current_tags
        assign tag_handle = tag | handle
        assign current_list = current_list | append: ',' | append: tag_handle
      endfor
      assign current_list = current_list | remove_first: ',' | split: ','
      assign facet_groups = 'Shape,Type,Style' | split: ','
    -%}

    {%- for current_handle in current_list -%}
      {%- liquid
        # current_tags may hold the handle from the URL; the collection's own tag has the real name.
        assign current_tag = ''
        for collection_tag in collection.all_tags
          assign collection_tag_handle = collection_tag | handle
          if collection_tag_handle == current_handle
            assign current_tag = collection_tag
            break
          endif
        endfor

        assign facet_group = current_tag | split: ':' | first
      -%}
      {%- unless facet_groups contains facet_group -%}
        {%- continue -%}
      {%- endunless -%}

      {%- capture facet_label -%}{%- render 'tag-facet-label', tag: current_tag, collection: collection -%}{%- endcapture -%}
      {%- liquid
        assign facet_label = facet_label | strip
        if facet_label == blank
          assign facet_label = current_tag | remove_first: ':' | remove_first: facet_group | strip
        endif

        assign other_tags = ''
        for other_handle in current_list
          if other_handle != current_handle
            assign other_tags = other_tags | append: '+' | append: other_handle
          endif
        endfor
        assign other_tags = other_tags | remove_first: '+'
      -%}
      {%- capture remove_url -%}{{ collection.url }}{% if other_tags != blank %}/{{ other_tags }}{% endif %}{% render 'collection-filter-query', results: collection %}{%- endcapture -%}

      <div class="removable-facet">
        <facet-link>
          <a href="{{ remove_url }}" class="tap-area link-faded" aria-label="{{ 'collection.faceting.remove_filter' | t: name: facet_label }}" data-no-instant>
            {%- render 'icon' with 'close', width: 10 -%}
          </a>
        </facet-link>

        {%- if section.settings.show_filter_group_name -%}
          <span class="text-subdued">{{- facet_group }}: {{ facet_label -}}</span>
        {%- else -%}
          <span class="text-subdued">{{- facet_label -}}</span>
        {%- endif -%}
      </div>

      {%- assign active_values_count = active_values_count | plus: 1 -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if active_values_count > 1 -%}
    {%- if request.page_type == 'collection' -%}
      {%- assign default_url = collection.url -%}
    {%- else -%}
      {%- capture default_url -%}{{ routes.search_url }}?q={{ search.terms }}&type=product&sort_by={{ search.sort_by }}{%- endcapture -%}
    {%- endif -%}

    <facet-link>
      <a href="{{ default_url }}" class="facets-clear-all text-subdued">
        <span class="link">{{ 'collection.faceting.clear_filters' | t }}</span>
      </a>
    </facet-link>
  {%- endif -%}
{%- endcapture -%}

{%- if active_values_count > 0 -%}
  <div class="active-facets {% if section.settings.filter_layout == 'drawer' %}justify-center{% endif %}">
    {{- active_facets -}}
  </div>
{%- endif -%}
