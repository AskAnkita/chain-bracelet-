{%- doc -%}
  Renders a simple line-art jewelry icon (ring, necklace, earrings, bracelet) to use as a
  placeholder product image before real product photos are uploaded. Matches the thin
  single-stroke outline style of Shopify's built-in placeholder illustrations.

  @param {number} [index] - which icon to show, cycled 0-3 (ring, necklace, earrings, bracelet)
  @param {string} [class] - class attribute to apply to the <svg>
{%- enddoc -%}

{%- liquid
  assign icon_index = index | default: 0 | modulo: 4
-%}

{%- case icon_index -%}
  {%- when 0 -%}
    {%- comment -%} Ring {%- endcomment -%}
    <svg
      aria-hidden="true"
      focusable="false"
      class="placeholder-svg {{ class }}"
      viewBox="0 0 64 64"
      width="100%"
      height="100%"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="32" cy="40" r="13" />
      <path d="M22 20 32 12 42 20 32 30Z" />
      <path d="M22 20 42 20M32 12 32 30" />
    </svg>

  {%- when 1 -%}
    {%- comment -%} Necklace {%- endcomment -%}
    <svg
      aria-hidden="true"
      focusable="false"
      class="placeholder-svg {{ class }}"
      viewBox="0 0 64 64"
      width="100%"
      height="100%"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 10Q32 48 52 10" />
      <circle cx="32" cy="39" r="6" />
    </svg>

  {%- when 2 -%}
    {%- comment -%} Earrings {%- endcomment -%}
    <svg
      aria-hidden="true"
      focusable="false"
      class="placeholder-svg {{ class }}"
      viewBox="0 0 64 64"
      width="100%"
      height="100%"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <circle cx="22" cy="14" r="2" />
      <path d="M22 18Q16 26 16 34Q16 40 22 42Q28 40 28 34Q28 26 22 18Z" />
      <circle cx="42" cy="14" r="2" />
      <path d="M42 18Q36 26 36 34Q36 40 42 42Q48 40 48 34Q48 26 42 18Z" />
    </svg>

  {%- when 3 -%}
    {%- comment -%} Bracelet {%- endcomment -%}
    <svg
      aria-hidden="true"
      focusable="false"
      class="placeholder-svg {{ class }}"
      viewBox="0 0 64 64"
      width="100%"
      height="100%"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <ellipse cx="32" cy="32" rx="22" ry="12" />
      <ellipse cx="32" cy="32" rx="17" ry="8" />
      <circle cx="32" cy="20" r="2" />
    </svg>
{%- endcase -%}
