{%- doc -%}
  This component is used to show the product gallery (used in product page and featured product section).

  @param {object} [product] - the product to render (if empty, renders placeholder content)
  @param {object} media - the media object to render
  @param {string} [product_form_id] - the product form id
  @param {string} [desktop_layout] - the layout on desktop (can be "carousel_thumbnails_left", "carousel_thumbnails_bottom", "carousel_dots", "grid", "grid_2x" or "grid_2x_highlighted")
  @param {string} [mobile_controls] - the controls to show on mobile (can be "thumbnails", "dots", "arrows" or "free_scroll")
  @param {boolean} [enable_media_autoplay] - if set to true media are autoplayed when switched to
  @param {boolean} [enable_video_looping] - if set to true videos automatically loop when finished
  @param {boolean} [enable_image_zoom] - if set to true the gallery allows zoom
  @param {number} [max_image_zoom_level] - the maximum zoom level allowed (if enabled)
  @param {object} [section]
{%- enddoc -%}

<style>
  {%- if mobile_controls == 'free_scroll' -%}
    @media screen and (max-width: 999px) {
      #shopify-section-{{ section.id }} {
        --product-gallery-carousel-grid: auto / auto-flow min(28rem, 75vw);
        --product-gallery-carousel-gap: 0.125rem;
        --product-gallery-carousel-scroll-snap-type: none;
      }
    }
  {%- endif -%}

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- if desktop_layout == 'carousel_thumbnails_left' or desktop_layout == 'grid' -%}
        /* Thumbnails on the left */
        --product-gallery-flex-direction: row-reverse;
        --product-gallery-thumbnail-list-grid-auto-flow: row;

        {%- if desktop_layout == 'carousel_thumbnails_left' -%}
          --product-gallery-thumbnail-list-max-height: 45rem;
        {%- endif -%}
      {%- endif -%}

      {%- if desktop_layout contains 'grid' -%}
        --product-gallery-carousel-grid: auto-flow dense / {% if desktop_layout == 'grid' %}auto{% else %}repeat(2, minmax(0, 1fr)){% endif %};
        --product-gallery-carousel-scroll-snap-type: none;
        --product-gallery-carousel-gap: {{ section.settings.desktop_media_grid_gap }}px;
      {%- endif -%}
    }

    {%- if desktop_layout == 'grid_2x_highlighted' -%}
      {%- comment -%}
        One large photo, then two small side by side, then one large, two small, and so on.
        Counted over the visible photos only ("of :not([hidden])"), so the rhythm holds for
        whichever metal is selected, including after switching metal on the page. A small
        photo left alone at the very end goes large rather than leave a gap beside it.
      {%- endcomment -%}
      #shopify-section-{{ section.id }} .product-gallery__media {
        grid-column: span 1;
      }

      #shopify-section-{{ section.id }} .product-gallery__media:nth-child(3n + 1 of .product-gallery__media:not([hidden])),
      #shopify-section-{{ section.id }} .product-gallery__media:nth-child(3n + 2 of .product-gallery__media:not([hidden])):nth-last-child(1 of .product-gallery__media:not([hidden])) {
        grid-column: span 2;
      }
    {%- endif -%}
  }
</style>

{%- comment -%}
  IMPLEMENTATION NOTE: Shopify does not natively offer a way to create a set of images per variant. This is often
  pretty limited when you have a lot of colors and would like to only see the images specific to a given color. To
  goes around that, Prestige offers a hack using alt tags whose usage is described here: https://support.maestrooo.com/article/721-variant-images-set
  The implementation is rather complex and inefficient due to a lot of string parsings, but it is, unfortunately, the
  only way to do it on Shopify right now.

  THEME CUSTOMISATION: the parsing below has been hardened compared to the stock Prestige implementation:

    1. An image is only ever filtered when its tag names an option that actually exists on the product. Stock
       Prestige hides any image whose alt text merely contains a "#" (for instance "Ranked #1 bestseller"), because
       the unmatched option resolves to nil and never equals the tag value.
    2. Option values may contain underscores and spaces ("#Color_Rose_Gold", "#Color_Rose Gold"). Stock Prestige
       splits on every underscore and keeps the last fragment, so "Rose_Gold" was read as "Gold".
    3. Option names are matched case and whitespace insensitively against the product options.
    4. An image may carry several tags ("#Color_Gold #Size_Large") and is shown only when all of them match the
       currently selected options.
    5. Only the fragments that follow a "#" are parsed as tags, so an underscore in the descriptive part of the alt
       text ("Size_chart reference #Color_Gold") can no longer be mistaken for a tag.
    6. The metal option's legacy tag names ("Jewelry material", "Jewellery materials") are folded onto its current
       name ("Material"), so alt text written before the option was renamed keeps working without re-tagging
       every image.
    7. For that metal option, values are matched by metal *family* rather than exact string: the variant values
       carry a karat ("10k White Gold", "925 Sterling Silver") while the images are only tagged by colour
       ("#Jewelry material_White_Gold", "#Jewelry material_Rose gold", "#Jewelry material_Gold"). Every white
       karat resolves to the White_Gold images, every rose karat to the Rose gold images, both yellow karats to
       the plain "Gold" images, and Sterling Silver (which has no images of its own) borrows the White_Gold set.
{%- endcomment -%}

{% liquid
  # A variant's own photo, when one is assigned in admin, always stays visible and opens the
  # gallery. These products assign none and rely on the "#Jewelry material_..." tags instead,
  # so the gallery opens on the first photo tagged for the selected metal (worked out below).
  assign variant_media = product.selected_or_first_available_variant.featured_media
  assign default_media = variant_media | default: product.featured_media
  assign product_gallery_carousel_id = 'product-gallery-carousel-' | append: product.id | append: '-' | append: section.id
  assign filtered_indexes = null | sort

  # While the skin-tone slider is switched off (Theme settings > Product page), the photo
  # it belongs to ("#skintone" in its alt text) is hidden from the gallery too, the same
  # way photos for other metals are: its position joins filtered_indexes below.
  assign skin_tone_indexes = null | sort
  unless settings.enable_skin_tone_viewer
    for media in product.media
      assign media_alt_key = media.alt | downcase | remove: '-'
      if media_alt_key contains '#skintone'
        assign media_position = media.position | sort
        assign skin_tone_indexes = skin_tone_indexes | concat: media_position
      endif
    endfor
  endunless

  if product.variants.size > 1
    for media in product.media
      unless media.alt contains '#'
        continue
      endunless

      if media.alt == product.title
        continue
      endif

      assign media_is_filtered = false
      assign alt_parts = media.alt | split: '#'

      for alt_part in alt_parts
        if forloop.index0 == 0
          continue
        endif

        assign media_group = alt_part | strip

        unless media_group contains '_'
          continue
        endunless

        assign media_group_option_name = media_group | split: '_' | first

        # replace: '_', ' ' -- a merchant writing a multi-word value naturally reaches
        # for the same underscore the examples use for the name/value separator itself
        # (e.g. "#Jewelry material_White_Gold" instead of "#Jewelry material_White
        # Gold"). Without this, that value is compared as "white_gold" against
        # Shopify's actual option value "white gold" and never matches -- which doesn't
        # just mis-tag that one image, it makes it permanently "filtered" no matter
        # which variant is selected, so switching options never reveals it and only the
        # untagged default image ever shows.
        assign media_group_value = media_group | remove_first: media_group_option_name | remove_first: '_' | replace: '_', ' ' | strip | downcase
        assign media_group_option_name = media_group_option_name | strip | downcase

        # The metal option was renamed from "Jewelry material" / "Jewellery materials"
        # down to just "Material", but the image alt tags still carry the old name.
        # Fold the legacy names onto the current one so existing alt text keeps working
        # without having to re-tag every image.
        assign media_group_option_name_normalised = media_group_option_name | replace: 'jewellery', 'jewelry' | replace: 'jewelry materials', 'material' | replace: 'jewelry material', 'material'

        assign has_matched_option = false
        assign matched_option_value = ''

        for product_option in product.options_with_values
          assign product_option_name = product_option.name | strip | downcase

          if product_option_name == media_group_option_name or product_option_name == media_group_option_name_normalised
            assign has_matched_option = true
            assign matched_option_value = product_option.selected_value | strip | downcase
            break
          endif
        endfor

        unless has_matched_option
          continue
        endunless

        if media_group_option_name_normalised == 'material'
          # ---- Metal-family matching ------------------------------------------------
          # Variant values carry the karat ("10k White Gold", "925 Sterling Silver")
          # while the alt tags only name the metal colour ("#Jewelry material_White_Gold",
          # "#Jewelry material_Rose gold", "#Jewelry material_Gold"). Compare the metal
          # *family* of each side rather than the raw string: every white karat matches
          # the White_Gold images, every rose karat the Rose gold images, and both
          # yellow karats the plain "Gold" images. Sterling silver ships no images of
          # its own, so it borrows the white-gold set. Order matters -- "white gold"
          # and "rose gold" both contain "gold", so the specific colours are tested
          # before the bare "gold" fallback.
          assign selected_metal_family = matched_option_value
          if matched_option_value contains 'rose'
            assign selected_metal_family = 'rose gold'
          elsif matched_option_value contains 'white'
            assign selected_metal_family = 'white gold'
          elsif matched_option_value contains 'silver'
            assign selected_metal_family = 'white gold'
          elsif matched_option_value contains 'yellow'
            assign selected_metal_family = 'gold'
          elsif matched_option_value contains 'gold'
            assign selected_metal_family = 'gold'
          endif

          assign tag_metal_family = media_group_value
          if media_group_value contains 'rose'
            assign tag_metal_family = 'rose gold'
          elsif media_group_value contains 'white'
            assign tag_metal_family = 'white gold'
          elsif media_group_value contains 'silver'
            assign tag_metal_family = 'white gold'
          elsif media_group_value contains 'yellow'
            assign tag_metal_family = 'gold'
          elsif media_group_value contains 'gold'
            assign tag_metal_family = 'gold'
          endif

          if selected_metal_family != tag_metal_family
            assign media_is_filtered = true
            break
          endif
        else
          if matched_option_value != media_group_value
            assign media_is_filtered = true
            break
          endif
        endif
      endfor

      # Only a photo assigned to the variant itself is kept despite its tag. The product's
      # first photo used to be kept too, so a gold photo stayed at the front of the gallery
      # with Silver or Rose Gold selected.
      if media_is_filtered
        if variant_media == blank or media != variant_media
          assign media_position = media.position | sort
          assign filtered_indexes = filtered_indexes | concat: media_position
        endif
      endif
    endfor
  endif

  if variant_media == blank
    assign default_media = nil
    for media in product.media
      unless filtered_indexes contains media.position or skin_tone_indexes contains media.position
        assign default_media = media
        break
      endunless
    endfor

    # Every photo tagged for other metals: show them all rather than an empty gallery
    # (still leaving out a hidden skin-tone photo).
    if default_media == nil
      assign filtered_indexes = null | sort
      for media in product.media
        unless skin_tone_indexes contains media.position
          assign default_media = media
          break
        endunless
      endfor
      assign default_media = default_media | default: product.featured_media
    endif
  endif

  assign filtered_indexes = filtered_indexes | concat: skin_tone_indexes | uniq

  # A product with a video opens on it rather than on the variant's photo (a variant can
  # only have a photo of its own); theme.js returns to it when another option is picked.
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      unless filtered_indexes contains media.position
        assign default_media = media
        break
      endunless
    endif
  endfor
%}

<product-gallery
  class="product-gallery"
  form="{{ product_form_id }}"
  filtered-indexes="{{ filtered_indexes | json }}"
  {% if enable_media_autoplay %}
    autoplay-media
  {% endif %}
  {% if enable_image_zoom %}
    allow-zoom="{{ max_image_zoom_level }}"
  {% endif %}
>
  {%- if enable_image_zoom -%}
    <open-lightbox-button class="contents">
      <button class="product-gallery__zoom-button circle-button circle-button--sm md:hidden">
        <span class="sr-only">{{ 'product.gallery.zoom' | t }}</span>
        {%- render 'icon' with 'zoom' -%}
      </button>
    </open-lightbox-button>
  {%- endif -%}

  <div class="product-gallery__image-list">
    {%- comment -%}
      ----------------------------------------------------------------------------------------------------------------------
      CAROUSEL
      ----------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    <div class="{% if mobile_controls == 'arrows' %}product-gallery__carousel-with-arrows{% else %}contents{% endif %}">
      {%- if mobile_controls == 'arrows' -%}
        <carousel-prev-button aria-controls="{{ product_gallery_carousel_id }}" class="contents">
          <button type="button" class="tap-area sm:hidden">
            <span class="sr-only">{{ 'general.accessibility.previous' | t }}</span>
            {%- render 'icon' with 'arrow-left', direction_aware: true -%}
          </button>
        </carousel-prev-button>
      {%- endif -%}

      <scroll-carousel
        adaptive-height
        id="{{ product_gallery_carousel_id }}"
        class="product-gallery__carousel scroll-area {% unless mobile_controls == 'arrows' %}full-bleed md:unbleed{% endunless %}"
        role="region"
      >
        {%- if product != blank -%}
          {%- liquid
            capture sizes
              echo '(max-width: 699px) calc(100vw - 40px), (max-width: 999px) calc(100vw - 64px), '

              assign media_ratio = 100 | minus: section.settings.product_info_size

              if desktop_layout == 'grid_2x'
                assign media_ratio = media_ratio | divided_by: 2
              endif

              if section.settings.container_size == 'full'
                echo 'calc(' | append: media_ratio | append: 'vw - 96px)'
              else
                assign media_ratio = 1260 | times: media_ratio | divided_by: 100 | round

                if desktop_layout == 'grid_2x'
                  assign maximum_width = '560px'
                else
                  assign maximum_width = '1100px'
                endif

                echo 'min(' | append: maximum_width | append: ', ' | append: media_ratio | append: 'px - 96px)'
              endif
            endcapture
          -%}

          {%- comment -%}
            Product photos on this store mix plain product shots with on-model/lifestyle
            shots, which rarely share a native aspect ratio -- left alone, each gallery
            slide renders at its own image's height (the carousel below is adaptive-height),
            so the gallery visibly jumps in size between slides, and looks inconsistent from
            one product page to the next. Forcing the same crop the product cards already use
            (settings.product_image_aspect_ratio) keeps every slide -- and the PDP gallery as
            a whole -- the same size as the grid it was clicked in from.
          {%- endcomment -%}
          {%- capture gallery_media_class -%}
            aspect-{{ settings.product_image_aspect_ratio | split: '_' | first }}
            {%- if settings.product_image_aspect_ratio contains 'crop' %} object-cover{% endif -%}
          {%- endcapture -%}

          {%- for media in product.media -%}
            <div
              class="product-gallery__media snap-center {% if media == default_media %}is-initial{% endif %}"
              data-media-type="{{ media.media_type }}"
              data-media-id="{{ media.id }}"
              role="group"
              aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: media.position, count: product.media.size }}"
              {% if filtered_indexes contains media.position %}
                hidden
              {% endif %}
            >
              {%- comment -%}
                Only the very first image used to preload; every other slide -- including the
                rest of the CURRENTLY selected variant's own photos -- was plain loading="lazy",
                which only starts fetching once a slide is scrolled near, i.e. right at the
                moment someone swipes to it or opens the zoom. That's the delay reported when
                browsing through a variant's other shots or opening zoom on anything but the
                first image. Every visible (non-hidden/non-filtered) slide now preloads too, at
                low fetch priority so it never competes with the real first-paint image, just
                arrives in the background well before it's actually clicked. Slides hidden for
                a *different* metal stay lazy -- switching metal already costs a network
                round-trip to re-render the section (see onSectionRerender_fn in theme.js), so
                preloading every other metal's photos as well would spend bandwidth without
                addressing that cost.
              {%- endcomment -%}
              {%- liquid
                assign preload = false
                assign low_priority = false

                if default_media == media
                  assign preload = true
                elsif filtered_indexes contains media.position
                  # stays lazy: hidden slide for a different metal than the one selected
                else
                  assign preload = true
                  assign low_priority = true
                endif

                assign show_controls = true
                if enable_media_autoplay
                  assign show_controls = false
                endif
              -%}

              {%- comment -%}
                Passing autoplay straight through (rather than leaving it false here and only
                imperatively calling .play() from onMediaSettle_fn in theme.js, as this used
                to) matters specifically for grid/grid_2x layouts: those show every media item
                at once, with no single "active" slide for onMediaSettle_fn to ever fire on for
                anything past the first tile, so a video sitting anywhere but position 1 never
                autoplayed no matter what this section's autoplay setting said. The <video-media>
                element (base-media.js) already watches its own visibility via IntersectionObserver
                whenever it has the autoplay attribute, so handing it autoplay directly here makes
                each video start on its own once it's actually visible, in grid layouts as much as
                carousel ones -- the onMediaSettle_fn path still also fires for whichever slide is
                "active", but .play() on an already-playing video is a no-op, so the two don't
                conflict.

                controls is now off specifically when autoplaying: the browser's native <video
                controls> bar (seek/volume/fullscreen/PiP) doesn't know the video started playing
                on its own via our IntersectionObserver rather than a click, so it can render
                already-visible instead of in its normal hover-to-reveal state -- needing an
                actual hover-then-unhover to make it re-evaluate and hide. An autoplaying preview
                isn't meant to be operated like a player anyway; the point is it just plays.
              {%- endcomment -%}
              {%- comment -%}
                A photo tagged "#skintone" in its alt text (a ring on a hand) gets the skin-tone
                slider; see snippets/skin-tone-image.liquid. Only while Theme settings > Product
                page > Show skin-tone slider is on; otherwise it's a plain photo.
              {%- endcomment -%}
              {%- assign media_alt_key = media.alt | downcase | remove: '-' -%}
              {%- if settings.enable_skin_tone_viewer and media.media_type == 'image' and media_alt_key contains '#skintone' -%}
                {%- render 'skin-tone-image',
                  media: media,
                  product: product,
                  sizes: sizes,
                  preload: preload,
                  low_priority: low_priority,
                  class: gallery_media_class
                -%}
              {%- else -%}
                {%- render 'media',
                  media: media,
                  sizes: sizes,
                  preload: preload,
                  low_priority: low_priority,
                  controls: show_controls,
                  playsinline: true,
                  autoplay: enable_media_autoplay,
                  muted: enable_media_autoplay,
                  loop: enable_video_looping,
                  group: 'product',
                  product: product,
                  class: gallery_media_class
                -%}
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            {%- capture placeholder_name -%}product-{{ i }}{%- endcapture -%}

            <div
              class="product-gallery__media snap-center {% if forloop.first %}is-initial{% endif %}"
              data-media-type="{{ media.media_type }}"
              data-media-position="{{ media.position }}"
              data-media-id="{{ media.id }}"
              role="group"
              aria-label="{{ 'general.accessibility.item_nth_of_count' | t: index: forloop.index, count: 3 }}"
            >
              {{- placeholder_name | placeholder_svg_tag: 'placeholder' -}}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </scroll-carousel>

      {%- if mobile_controls == 'arrows' -%}
        <carousel-next-button aria-controls="{{ product_gallery_carousel_id }}" class="contents">
          <button type="button" class="tap-area sm:hidden">
            <span class="sr-only">{{ 'general.accessibility.next' | t }}</span>
            {%- render 'icon' with 'arrow-right', direction_aware: true -%}
          </button>
        </carousel-next-button>
      {%- endif -%}
    </div>

    {%- comment -%}
      ----------------------------------------------------------------------------------------------------------------------
      VIEW IN YOUR SPACE
      ----------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}

    {%- if first_3d_model -%}
      <link rel="stylesheet" href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css" media="print" onload="this.media='all'; this.onload = null">

      <button
        class="button w-full md:hidden"
        data-shopify-xr
        data-shopify-model3d-id="{{ first_3d_model.id }}"
        data-shopify-model3d-default-id="{{ first_3d_model.id }}"
        data-shopify-title="{{ product.title | escape }}"
        data-shopify-xr-hidden
      >
        <span class="text-with-icon justify-center">
          {%- render 'icon' with 'media-view-in-space' -%}
          {{- 'product.general.view_in_space' | t -}}
        </span>
      </button>
    {%- endif -%}
  </div>

  {%- comment -%}
    ----------------------------------------------------------------------------------------------------------------------
    CONTROLS
    ----------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- if product.media.size > 1 or product == blank -%}
    {%- liquid
      assign show_thumbnails_mobile = false
      assign show_thumbnails_desktop = false

      if mobile_controls == 'thumbnails'
        assign show_thumbnails_mobile = true
      endif

      if desktop_layout contains 'thumbnails' or desktop_layout == 'grid'
        assign show_thumbnails_desktop = true
      endif
    -%}

    {%- if show_thumbnails_mobile or show_thumbnails_desktop -%}
      <safe-sticky class="product-gallery__thumbnail-list {% unless show_thumbnails_mobile %}hidden{% endunless %} {% unless show_thumbnails_desktop %}md:hidden{% else %}md:block{% endunless %}">
        <product-gallery-navigation align-selected aria-controls="{{ product_gallery_carousel_id }}" class="product-gallery__thumbnail-scroller bleed md:unbleed">
          {%- if product != blank -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-gallery__thumbnail"
                {% if filtered_indexes contains media.position %}
                  hidden
                {% endif %}
                data-media-type="{{ media.media_type }}"
                data-media-position="{{ media.position }}"
                data-media-id="{{ media.id }}"
                aria-current="{% if media == default_media %}true{% else %}false{% endif %}"
                aria-label="{{ 'general.accessibility.go_to_item' | t: index: forloop.index | escape }}"
              >
                {{- media | image_url: width: media.preview_image.width | image_tag: sizes: '56px', widths: '56,112,168', class: gallery_media_class | append: ' w-full' -}}

                {%- unless media.media_type == 'image' -%}
                  <div class="product-gallery__media-badge">
                    {%- if media.media_type == 'model' -%}
                      {%- render 'icon' with 'media-model-badge', width: 12 -%}
                    {%- else -%}
                      {%- render 'icon' with 'media-video-badge', width: 12 -%}
                    {%- endif -%}
                  </div>
                {% endunless %}
              </button>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..3) -%}
              {%- capture placeholder_name -%}product-{% cycle '1', '2', '3', '4', '5' %}{%- endcapture -%}

              <button
                type="button"
                class="product-gallery__thumbnail"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                aria-label="{{ 'general.accessibility.go_to_item' | t: index: forloop.index | escape }}"
              >
                {{- placeholder_name | placeholder_svg_tag: 'placeholder object-contain' -}}
              </button>
            {%- endfor -%}
          {%- endif -%}
        </product-gallery-navigation>
      </safe-sticky>
    {%- endif -%}

    {%- if mobile_controls == 'dots' or desktop_layout == 'carousel_dots' -%}
      <carousel-navigation
        class="page-dots align-self-center {% unless mobile_controls == 'dots' %}md-max:hidden{% endunless %} {% unless desktop_layout == 'carousel_dots' %}md:hidden{% endunless %}"
        aria-controls="{{ product_gallery_carousel_id }}"
      >
        {%- if product != blank -%}
          {%- for media in product.media -%}
            <button
              type="button"
              class="tap-area"
              {% if filtered_indexes contains media.position %}
                hidden
              {% endif %}
              aria-current="{% if media == default_media %}true{% else %}false{% endif %}"
            >
              <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: media.position }}</span>
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..3) -%}
            <button type="button" class="tap-area" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
              <span class="sr-only">{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}</span>
            </button>
          {%- endfor -%}
        {%- endif -%}
