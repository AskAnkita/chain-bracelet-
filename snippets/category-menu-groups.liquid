{%- doc -%}
  Builds a category's menu links from its products' tags: one group per tag prefix —
  Shop by Type, Shop by Shape, Shop by Style. Shared by the desktop mega menu panel
  (snippets/category-mega-menu.liquid) and the mobile drawer (snippets/header-sidebar.liquid)
  so both offer the same links to the same places.

  Where each link points: a tag whose own collection exists and carries at least
  `min_products` products links straight to it (/collections/stud-earrings). A tag whose
  collection is missing or nearly empty links to the parent collection filtered by that
  tag instead (/collections/earrings?filter.p.tag=Shape%3APrincess), so the menu stays
  full but no link lands on a page with one lonely product. The filtered URLs need tag
  filters switched on in Shopify admin > Search & Discovery > Filters.

  Outputs nothing when the collection carries none of those tags.

  @param {object} collection - the category's collection
  @param {number} [min_products] - products a tag's own collection needs before the link
    points at it rather than at the filtered parent (default 3)
  @param {string} [layout] - "columns" for the desktop panel (default), or "sidebar" for
    the mobile drawer, where each group is an accordion `<li>` for the caller's list
  @param {object} [section]
{%- enddoc -%}

{%- liquid
  assign min_products = min_products | default: 3
  assign layout = layout | default: 'columns'

  assign sidebar_heading_class = ''
  if section.settings.sidebar_text_font == 'heading'
    assign sidebar_heading_class = 'h6'
  endif

  # One group per tag prefix, in the order a shopper shops: what the piece is, then the
  # stone, then the setting. A tag that just repeats the category is dropped
  # (Type:Necklace, Type:Earrings), since it matches nearly every product in it, and so is
  # the category word inside a type — under NECKLACES, Type:Station Necklace reads as
  # "Station". Shapes read as "Heart Cut" etc., the wording the product titles use; a bare
  # "Emerald" would read as the stone.
  assign category_title_downcase = collection.title | downcase
  assign generic_type = category_title_downcase
  assign category_last = category_title_downcase | slice: -1, 1
  if category_last == 's'
    assign generic_size = category_title_downcase.size | minus: 1
    assign generic_type = category_title_downcase | slice: 0, generic_size
  endif
  assign generic_suffix = ' ' | append: generic_type
  assign tag_groups = 'Type,Shape,Style' | split: ','
  assign seen_urls = ''
-%}

{%- capture groups_content -%}
  {%- for group in tag_groups -%}
    {%- assign prefix = group | append: ':' -%}
    {%- assign group_count = 0 -%}

    {%- capture group_links -%}
      {%- for tag in collection.all_tags -%}
        {%- assign tag_start = tag | slice: 0, prefix.size -%}
        {%- if tag_start != prefix -%}
          {%- continue -%}
        {%- endif -%}

        {%- liquid
          assign value = tag | remove_first: prefix | strip
          assign value_downcase = value | downcase
        -%}
        {%- if value_downcase == generic_type or value_downcase == category_title_downcase -%}
          {%- continue -%}
        {%- endif -%}

        {%- liquid
          # The collection this tag has of its own, if the store has one. The titles follow
          # the same rules the importer creates them by: "Princess" under Earrings is
          # Princess Cut Earrings, "Tennis Necklace" is Tennis Necklaces, "Halo" under Rings
          # is Halo Rings, "Studs" is Stud Earrings. Whichever of those handles exists, with
          # enough products behind it, wins.
          assign value_singular = value
          assign value_last = value_downcase | slice: -1, 1
          if value_last == 's'
            assign value_singular_size = value.size | minus: 1
            assign value_singular = value | slice: 0, value_singular_size
          endif

          if group == 'Shape'
            assign value = value | append: ' Cut'
            assign value_singular = value
          endif

          assign handle_plural = value | handleize | append: 's'
          assign handle_paired = value | append: ' ' | append: collection.title | handleize
          assign handle_paired_singular = value_singular | append: ' ' | append: collection.title | handleize
          assign candidate_handles = handle_plural | append: ',' | append: handle_paired | append: ',' | append: handle_paired_singular | split: ','

          # `products_count` on a handle the store has no collection for is not a number,
          # and comparing that to the threshold raises, so it is coerced first: a missing
          # collection counts as zero and falls through to the filter.
          assign link_url = ''
          for candidate_handle in candidate_handles
            assign candidate_collection = collections[candidate_handle]
            assign candidate_count = candidate_collection.products_count | plus: 0
            if candidate_count >= min_products
              assign link_url = candidate_collection.url
              break
            endif
          endfor

          # Too thin, or no collection at all: the category, filtered to this tag.
          if link_url == blank
            assign tag_param = tag | url_encode
            assign link_url = collection.url | append: '?filter.p.tag=' | append: tag_param
          endif

          # "Station Necklace" under NECKLACES is just "Station"; "Studs" stays "Studs".
          assign label = value

          if group == 'Type' and value.size > generic_suffix.size
            assign tail_offset = 0 | minus: generic_suffix.size
            assign value_tail = value_downcase | slice: tail_offset, generic_suffix.size

            if value_tail == generic_suffix
              assign label_size = value.size | minus: generic_suffix.size
              assign label = value | slice: 0, label_size
            endif
          endif
        -%}

        {%- comment -%}
          Two tags can describe the same thing — Type:Eternity Ring and Style:Eternity
          under RINGS — so anything already listed higher up, by where it goes or by what
          it reads as, is skipped rather than shown twice.
        {%- endcomment -%}
        {%- liquid
          assign dedupe_key = '|' | append: link_url | append: '|'
          assign label_key = '|' | append: label | downcase | append: '|'
        -%}
        {%- if seen_urls contains dedupe_key or seen_urls contains label_key -%}
          {%- continue -%}
        {%- endif -%}
        {%- assign seen_urls = seen_urls | append: dedupe_key | append: label_key -%}

        {%- assign group_count = group_count | plus: 1 -%}

        {%- if layout == 'sidebar' -%}
          <a href="{{ link_url }}" class="link-faded-reverse">{{ label }}</a>
        {%- else -%}
          <li><a href="{{ link_url }}" class="link-reverse">{{ label }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if group_count > 0 -%}
      {%- if layout == 'sidebar' -%}
        {%- comment -%}
          Same markup the sidebar's own third-level menus use, so the drawer's styles and
          its accordion behaviour carry over without any new CSS.
        {%- endcomment -%}
        <li>
          <accordion-disclosure>
            <details class="accordion__disclosure group">
              <summary class="header-sidebar__linklist-button {{ sidebar_heading_class }}">
                {{- 'Shop by ' | append: group -}}
                <span class="animated-plus group-expanded:rotate" aria-hidden="true"></span>
              </summary>

              <div class="header-sidebar__nested-linklist">{{ group_links }}</div>
            </details>
          </accordion-disclosure>
        </li>
      {%- else -%}
        <div class="category-mega-menu__column">
          <span class="category-mega-menu__column-title">Shop by {{ group }}</span>
          <ul class="category-mega-menu__column-links unstyled-list" role="list">{{ group_links }}</ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if groups_content != blank -%}
  {%- if layout == 'sidebar' -%}
    {{- groups_content -}}
  {%- else -%}
    <div class="category-mega-menu__columns">{{ groups_content }}</div>
  {%- endif -%}
{%- endif -%}
