    {
      "type": "range",
      "id": "icon_stroke_width",
      "label": "Icon stroke width",
      "min": 1,
      "max": 2,
      "step": 0.5,
      "unit": "px",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "icon_spacing",
